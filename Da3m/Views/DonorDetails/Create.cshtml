@model Da3m.Domain.DonorDetail
@{
    ViewData["Title"] = "إضافة متبرع";
}

<div class="page-header">
    <h2><i class="bi bi-gift me-2"></i>إكمال بيانات المتبرع</h2>
    <p>أدخل بيانات المتبرع</p>
</div>

<!-- شريط التقدم -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center
                    justify-content-center"
             style="width:32px;height:32px;
                    background:#2E7D32;color:white;font-weight:700">
            ✓
        </div>
        <span class="text-muted" style="font-size:.88rem">
            تم إنشاء الحساب
        </span>
        <div style="flex:1;height:2px;background:#E0E0E0">
            <div style="width:50%;height:100%;
                        background:#AD1457"></div>
        </div>
        <div class="rounded-circle d-flex align-items-center
                    justify-content-center"
             style="width:32px;height:32px;
                    background:#AD1457;color:white;font-weight:700">
            2
        </div>
        <span style="font-size:.88rem;font-weight:700;
                     color:#AD1457">
            بيانات المتبرع
        </span>
    </div>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <!-- ✅ نوع التبرع مع onchange -->
        <div class="mb-3">
            <label asp-for="PreferredDonationType"
                   class="form-label fw-bold">
                نوع التبرع المفضل
            </label>
            <select asp-for="PreferredDonationType"
                    class="form-select"
                    id="donationType"
                    onchange="toggleFields()">
                <option value="">-- اختر --</option>
                <option value="مالي">مالي 💰</option>
                <option value="جهاز تعويضي">جهاز تعويضي 🦾</option>
                <option value="كلاهما">كلاهما</option>
            </select>
        </div>

        <!-- ✅ يظهر فقط عند مالي أو كلاهما -->
        <div class="mb-3" id="amountDiv" style="display:none">
            <label asp-for="TotalDonatedAmount"
                   class="form-label fw-bold">
                مبلغ التبرع الأولي
            </label>
            <div class="input-group">
                <input asp-for="TotalDonatedAmount"
                       class="form-control"
                       type="number" step="0.01"
                       placeholder="0.00" />
                <span class="input-group-text">$</span>
            </div>
            <small class="text-muted mt-1 d-block">
                <i class="bi bi-info-circle me-1"></i>
                سيُضاف تلقائياً لسجل التبرعات
            </small>
        </div>

        <!-- ✅ يظهر فقط عند جهاز أو كلاهما -->
        <div class="mb-4" id="devicesDiv" style="display:none">
            <label asp-for="DonatedDevicesCount"
                   class="form-label fw-bold">
                عدد الأجهزة المتبرع بها
            </label>
            <input asp-for="DonatedDevicesCount"
                   class="form-control"
                   type="number" min="0"
                   placeholder="0" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i> إكمال التسجيل
            </button>
            <a asp-controller="Users" asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleFields() {
            var type    = document.getElementById('donationType').value;
            var amount  = document.getElementById('amountDiv');
            var devices = document.getElementById('devicesDiv');

            // إخفاء الكل أولاً
            amount.style.display  = 'none';
            devices.style.display = 'none';
            // إظهار حسب الاختيار
            if (type === 'مالي') {
                amount.style.display = 'block';
            }
            else if (type === 'جهاز تعويضي') {
                devices.style.display = 'block';
            }
            else if (type === 'كلاهما') {
                amount.style.display  = 'block';
                devices.style.display = 'block';
            }
        }
    </script>
}