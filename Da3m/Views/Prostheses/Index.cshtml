@model IEnumerable<Da3m.Domain.Prostheses>
@{
    ViewData["Title"] = "الأجهزة التعويضية";
    var dict = ViewData["UsersDict"] as Dictionary<int, string>
               ?? new Dictionary<int, string>();
    bool isAdmin = ViewBag.CurrentRole?.ToString().ToLower() == "admin"
               || ViewBag.CurrentRole?.ToString() == "مدير";
    bool isManufacturer = ViewBag.CurrentRole?.ToString().ToLower() == "manufacturer"
                  || ViewBag.CurrentRole?.ToString() == "مصنع";
    bool isDonor = ViewBag.CurrentRole?.ToString().ToLower() == "donor"
              || ViewBag.CurrentRole?.ToString() == "متبرع";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-robot me-2"></i>الأجهزة التعويضية</h2>
        <p>إدارة جميع الأجهزة التعويضية في المنصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة جهاز
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد أجهزة مسجلة حالياً
    </div>
}
else
{
    <!-- إحصائيات -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="stat-card">
                <div class="stat-icon mb-2"
                     style="background:#F3E5F5">
                    <i class="bi bi-robot"
                       style="color:#6A1B9A"></i>
                </div>
                <div class="stat-num">@Model.Count()</div>
                <div class="stat-label">إجمالي الأجهزة</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="stat-card">
                <div class="stat-icon mb-2"
                     style="background:#E8F5E9">
                    <i class="bi bi-check-circle"
                       style="color:#2E7D32"></i>
                </div>
                <div class="stat-num">
                    @Model.Count(d => d.IsAvailable)
                </div>
                <div class="stat-label">الأجهزة المتاحة</div>
            </div>
        </div>
    </div>

    <!-- الجدول -->
    <div class="da3m-table">
        <table class="table table-hover mb-0"
               style="table-layout:fixed;width:100%">
            <thead>
                <tr>
                    <th style="width:5%">#</th>
                    <th style="width:14%">نوع الطرف</th>
                    <th style="width:14%">الطول / العرض</th>
                    <th style="width:10%">المادة</th>
                    <th style="width:12%">الحالة</th>
                    <th style="width:10%">الاتجاه</th>
                    <th style="width:15%">المالك</th>
                    <th style="width:10%">متاح</th>
                    <th style="width:10%">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Prostheses device in Model)
                {
                    var uName = dict.ContainsKey(device.UserId)
                        ? dict[device.UserId] : "—";

                    <tr>
                        <td>@device.DeviceId</td>

                        <!-- نوع الطرف -->
                        <td>
                            <span class="badge-status d-block
                                         text-center"
                                  style="background:#F3E5F5;
                                         color:#6A1B9A;
                                         white-space:nowrap">
                                <i class="bi bi-robot me-1"></i>
                                @device.LimbType
                            </span>
                        </td>

                        <!-- الطول / العرض -->
                        <td class="text-center">
                            <div style="font-size:.82rem;
                                font-weight:700;
                                color:#1565C0">
                                @device.LengthCm cm
                            </div>
                            <div style="font-size:.75rem;
                                color:#7a8999">
                                × @device.WidthCm cm
                            </div>
                        </td>

                        <!-- المادة -->
                        <td style="font-size:.85rem">
                            @(device.Material ?? "—")
                        </td>

                        <!-- الحالة -->
                        <td>
                            @{
                                var condBg = device.Condition == "جديد"
                                    ? "#E8F5E9" : "#FFF3E0";
                                var condColor = device.Condition == "جديد"
                                    ? "#2E7D32" : "#E65100";
                            }
                            <span class="badge-status"
                                  style="background:@condBg;
                                color:@condColor;
                                white-space:nowrap">
                                @(device.Condition ?? "—")
                            </span>
                        </td>

                        <!-- الاتجاه -->
                        <td class="text-center">
                            @if (device.Direction != null)
                            {
                                <span class="badge-status"
                                      style="background:#E3F2FD;
                                    color:#1565C0">
                                    @device.Direction
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <!-- المالك -->
                        <td>
                            <div class="d-flex align-items-center
                                gap-1">
                                <div class="user-avatar"
                                     style="width:28px;height:28px;
                                    font-size:.75rem;
                                    flex-shrink:0">
                                    @uName.Substring(0, 1)
                                </div>
                                <span style="font-size:.82rem;
                                    overflow:hidden;
                                    text-overflow:ellipsis;
                                    white-space:nowrap">
                                    @uName
                                </span>
                            </div>
                        </td>

                        <!-- متاح -->
                        <td class="text-center">
                            @if (device.IsAvailable)
                            {
                                <span class="badge-status d-block
                                    text-center"
                                      style="background:#E8F5E9;color:#2E7D32; white-space:nowrap">
                                    <i class="bi bi-check-circle"></i>
                                    متاح
                                </span>
                            }
                            else
                            {
                                <span class="badge-status"
                                      style="background:#FFEBEE;
                                    color:#C62828 ; white-space:nowrap">
                                    <i class="bi bi-x-circle"></i>
                                    غير متاح
                                </span>
                            }
                        </td>
                        <!-- الإجراءات -->
                        @if (isAdmin || isManufacturer || isDonor)
                        {
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                       asp-route-id="@device.DeviceId"
                                       class="btn btn-sm btn-outline-warning"
                                       title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@device.DeviceId"
                                          method="post"
                                          style="display:inline"
                                          onsubmit="return confirm(
                                        'هل أنت متأكد من الحذف؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm
                                            btn-outline-danger"
                                                title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                               
                            </div>
                        </td>
                        }
                        else
                        {
                            <td>
                                <span class="text-muted">صلاحيات محددة(●'◡'●)</span>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}