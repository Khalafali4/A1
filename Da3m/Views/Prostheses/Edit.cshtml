@model Da3m.Domain.Prostheses
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "تعديل الجهاز";
}

<div class="page-header">
    <h2><i class="bi bi-robot me-2"></i>تعديل بيانات الجهاز</h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="DeviceId" />
        <input type="hidden" asp-for="AddedAt" />

        @{
            var role = ViewBag.CurrentRole as string;
            var isAdmin = !string.IsNullOrWhiteSpace(role) && (
                role.Trim().Equals("admin", StringComparison.OrdinalIgnoreCase)
                || role.Trim() == "مدير");
        }

        @if (isAdmin)
        {
            <div class="mb-3">
                <label asp-for="UserId" class="form-label fw-bold">المالك</label>
                <select asp-for="UserId" class="form-select"
                        asp-items="@(new SelectList((IEnumerable<Da3m.Domain.User>)ViewData["Users"], "UserId", "FullName", Model.UserId))">
                    <option value="">-- اختر --</option>
                </select>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="UserId" />
        }

        <div class="mb-3">
            <label asp-for="LimbType" class="form-label fw-bold">نوع الطرف</label>
            <select asp-for="LimbType" class="form-select">
                <option value="">-- اختر --</option>
                <option value="طرف علوي">طرف علوي 🦾</option>
                <option value="طرف سفلي">طرف سفلي 🦿</option>
            </select>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="LengthCm" class="form-label fw-bold">الطول (cm)</label>
                <div class="input-group">
                    <input asp-for="LengthCm" class="form-control" type="number" step="0.01" />
                    <span class="input-group-text">cm</span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="WidthCm" class="form-label fw-bold">العرض (cm)</label>
                <div class="input-group">
                    <input asp-for="WidthCm" class="form-control" type="number" step="0.01" />
                    <span class="input-group-text">cm</span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Material" class="form-label fw-bold">المادة</label>
            <input asp-for="Material" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Condition" class="form-label fw-bold">الحالة</label>
            <select asp-for="Condition" class="form-select">
                <option value="">-- اختر --</option>
                <option value="جديد">جديد</option>
                <option value="مستعمل جيد">مستعمل - جيد</option>
                <option value="مستعمل مقبول">مستعمل - مقبول</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Direction" class="form-label fw-bold">الاتجاه</label>
            <select asp-for="Direction" class="form-select">
                <option value="">-- اختر --</option>
                <option value="أيمن">أيمن</option>
                <option value="أيسر">أيسر</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Note" class="form-label fw-bold">ملاحظات</label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-4">
            <div class="form-check form-switch">
                <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                <label asp-for="IsAvailable" class="form-check-label fw-bold">الجهاز متاح</label>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>