<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — منصة دعم</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --primary:    #1565C0;
            --primary-dk: #0D47A1;
            --primary-lt: #E3F2FD;
            --accent:     #00ACC1;
            --sidebar-w:  260px;
            --topbar-h:   64px;
        }

        * { font-family: 'Cairo', sans-serif; }

        body {
            background: #F0F4F8;
            min-height: 100vh;
        }

        /* ── Sidebar ───────────────────────── */
        #sidebar {
            position: fixed;
            top: 0; right: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--primary-dk);
            z-index: 1000;
            overflow-y: auto;
            transition: transform .3s ease;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 18px;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

        .sidebar-brand .logo-icon {
            width: 42px; height: 42px;
            background: var(--accent);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: white;
        }

        .sidebar-brand span {
            font-size: 1.3rem;
            font-weight: 900;
            color: white;
            letter-spacing: 1px;
        }

        .sidebar-label {
            font-size: .7rem;
            font-weight: 700;
            color: rgba(255,255,255,.4);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 18px 18px 6px;
        }

        .nav-link-side {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 18px;
            color: rgba(255,255,255,.75);
            text-decoration: none;
            border-radius: 8px;
            margin: 2px 10px;
            font-size: .92rem;
            font-weight: 600;
            transition: all .2s;
        }

        .nav-link-side:hover { background: rgba(255,255,255,.12); color: white; }
        .nav-link-side.active { background: var(--accent); color: white; }
        .nav-link-side i { font-size: 1.1rem; width: 22px; text-align: center; }

        /* ── Topbar ────────────────────────── */
        #topbar {
            position: fixed;
            top: 0; left: 0;
            right: var(--sidebar-w);
            height: var(--topbar-h);
            background: white;
            border-bottom: 1px solid #E0E7EF;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 999;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
        }

        .topbar-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary-dk);
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 36px; height: 36px;
            background: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: .9rem;
        }
        /* ── Main Content ──────────────────── */
        #main-content {
            margin-right: var(--sidebar-w);
            margin-top: var(--topbar-h);
            padding: 28px;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* ── Cards ─────────────────────────── */
        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            transition: transform .2s, box-shadow .2s;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0,0,0,.1);
        }

        .stat-icon {
            width: 52px; height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .stat-num {
            font-size: 1.9rem;
            font-weight: 900;
            color: #1a2332;
            line-height: 1;
        }

        .stat-label {
            font-size: .82rem;
            color: #7a8999;
            font-weight: 600;
            margin-top: 4px;
        }

        /* ── Table ─────────────────────────── */
        .da3m-table {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }

        .da3m-table .table { margin: 0; }

        .da3m-table .table thead th {
            background: var(--primary-lt);
            color: var(--primary-dk);
            font-weight: 700;
            border: none;
            padding: 14px 16px;
            font-size: .85rem;
        }

        .da3m-table .table tbody td {
            padding: 12px 16px;
            font-size: .88rem;
            color: #374151;
            vertical-align: middle;
            border-color: #F0F4F8;
        }

        .badge-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: .78rem;
            font-weight: 700;
        }

        /* ── Page Header ───────────────────── */
        .page-header { margin-bottom: 24px; }
        .page-header h2 {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--primary-dk);
            margin: 0;
        }
        .page-header p {
            color: #7a8999;
            margin: 4px 0 0;
            font-size: .88rem;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
@{
    var role = ViewBag.CurrentRole as string ?? "";
    bool isAdmin        = role.ToLower() == "admin"        || role == "مدير";
    bool isDoctor       = role.ToLower() == "doctor"       || role == "طبيب";
    bool isPatient      = role.ToLower() == "patient"      || role == "مريض";
    bool isDonor        = role.ToLower() == "donor"        || role == "متبرع";
    bool isManufacturer = role.ToLower() == "manufacturer" || role == "مصنع";
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<!-- ══ SIDEBAR ══════════════════════════════ -->
<nav id="sidebar">

    <div class="sidebar-brand">
        <div class="logo-icon">
            <i class="bi bi-heart-pulse-fill"></i>
        </div>
        <span>دعم</span>
    </div>

    <!-- الرئيسية — للجميع -->
    <div class="sidebar-label">الرئيسية</div>
    <a class="nav-link-side @(ctrl == "Home" ? "active" : "")"
       href="@Url.Action("Index","Home")">
        <i class="bi bi-grid-1x2-fill"></i> لوحة التحكم
    </a>

    <!-- إدارة المستخدمين — Admin فقط -->
    @if (isAdmin)
    {
        <div class="sidebar-label">إدارة المستخدمين</div>
        <a class="nav-link-side @(ctrl == "Users" ? "active" : "")"
           href="@Url.Action("Index","Users")">
            <i class="bi bi-people-fill"></i> المستخدمون
        </a>
        <a class="nav-link-side @(ctrl == "Roles" ? "active" : "")"
           href="@Url.Action("Index","Roles")">
            <i class="bi bi-shield-fill"></i> الأدوار
        </a>
    }
    <!-- الأطباء — Admin + Doctor -->
  
       @if (isAdmin || isDonor)
        {
            <a class="nav-link-side @(ctrl == "DonorDetails" ? "active" : "")"
               href="@Url.Action("Index","DonorDetails")">
                <i class="bi bi-gift-fill"></i> المتبرعون
            </a>
        } 
        @if (isAdmin || isPatient)
        {
            <a class="nav-link-side @(ctrl == "Doctors" ? "active" : "")"
               href="@Url.Action("Index","Doctors")">
                <i class="bi bi-person-badge-fill"></i> الأطباء
            </a>
        }
        @if(isAdmin || isDoctor){
        <a class="nav-link-side @(ctrl == "PatientDetails" ? "active" : "")"
           href="@Url.Action("Index","PatientDetails")">
            <i class="bi bi-person-heart"></i> المرضى
        </a>
        }
          @if (isAdmin || isManufacturer)
        {
            <a class="nav-link-side @(ctrl == "ManufacturerDetails" ? "active" : "")"
               href="@Url.Action("Index","ManufacturerDetails")">
                <i class="bi bi-building"></i>الشركات المصنعة
            </a>
        }

    <!-- التبرعات والأجهزة -->
    @if (isAdmin || isDonor || isManufacturer)
    {
        <div class="sidebar-label">التبرعات والأجهزة</div>

        @if (isAdmin || isDonor)
        {
            <a class="nav-link-side @(ctrl == "Donations" ? "active" : "")"
               href="@Url.Action("Index","Donations")">
                <i class="bi bi-cash-coin"></i> التبرعات
            </a>
        }

        <a class="nav-link-side @(ctrl == "Prostheses" ? "active" : "")"
           href="@Url.Action("Index","Prostheses")">
            <i class="bi bi-robot"></i> الأجهزة التعويضية
        </a>

      
    }

    <!-- المطابقة والتقارير — Admin + Doctor -->
    @if (isAdmin || isDoctor || isPatient)
    {
        <div class="sidebar-label">المطابقة والتقارير</div>
        <a class="nav-link-side @(ctrl == "Measurements" ? "active" : "")"
           href="@Url.Action("Index","Measurements")">
            <i class="bi bi-rulers"></i> القياسات
        </a>
        <a class="nav-link-side @(ctrl == "Matches" ? "active" : "")"
           href="@Url.Action("Index","Matches")">
            <i class="bi bi-shuffle"></i> المطابقات
        </a>
        <a class="nav-link-side @(ctrl == "VisitReports" ? "active" : "")"
           href="@Url.Action("Index","VisitReports")">
            <i class="bi bi-file-medical-fill"></i> تقارير الزيارات
        </a>
    }

    <!-- الإعدادات — Admin فقط -->
    @if (isAdmin || isDoctor || isDonor || isManufacturer)
    {
        <div class="sidebar-label">الإعدادات</div>
        <a class="nav-link-side @(ctrl == "Centers" ? "active" : "")"
           href="@Url.Action("Index","Centers")">
            <i class="bi bi-hospital-fill"></i> المراكز
        </a>
    }

</nav>

<!-- ══ TOPBAR ════════════════════════════════ -->
<header id="topbar">
    <div class="topbar-title">
        <i class="bi bi-heart-pulse text-primary me-2"></i>
        @ViewData["Title"]
    </div>
    <div class="topbar-user">
        <span style="font-size:.82rem;color:#7a8999;
                     font-weight:600">
            @(ViewBag.CurrentRole ?? "")
        </span>

        <!-- ✅ Avatar قابل للنقر -->
        <a asp-controller="Account"
           asp-action="Profile"
           class="d-flex align-items-center gap-2
                  text-decoration-none">
            <div class="user-avatar">
                @{
                    var uName = ViewBag.CurrentUser as string ?? "م";
                }
                @uName.Substring(0, 1)
            </div>
            <span style="font-size:.85rem;font-weight:700;
                         color:#1565C0">
                @(ViewBag.CurrentUser ?? "")
            </span>
        </a>

        <a href="@Url.Action("Logout","Account")"
           class="btn btn-sm btn-outline-danger ms-2"
           onclick="return confirm(
               'هل تريد تسجيل الخروج؟')">
            <i class="bi bi-box-arrow-right"></i>
        </a>
    </div>
</header>

<!-- ══ MAIN ══════════════════════════════════ -->
<main id="main-content">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
    // إخفاء رسائل التنبيه تلقائياً بعد 3 ثواني
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(function() {
                    alert.remove();
                }, 500);
            });
        }, 1500);
    });
</script>
</body>
</html>