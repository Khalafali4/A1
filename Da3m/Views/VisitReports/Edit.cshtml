@model Da3m.Domain.VisitReport
@{
    ViewData["Title"] = "تعديل التقرير";
    var matches = ViewData["Matches"]
                  as IEnumerable<Da3m.Domain.Match>;
    var centers = ViewData["Centers"]
                  as IEnumerable<Da3m.Domain.Center>;
}

<div class="page-header">
    <h2><i class="bi bi-file-medical me-2"></i>تعديل التقرير</h2>
</div>

<div class="da3m-table p-4" style="max-width:650px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReportId" />
        <input type="hidden" asp-for="ReportDate" />

        <div class="mb-3">
            <label asp-for="MatchId" class="form-label fw-bold">
                المطابقة
            </label>
            <select asp-for="MatchId" class="form-select">
                <option value="">-- اختر --</option>
                @if (matches != null)
                {
                    foreach (var m in matches)
                    {
                        if (m.MatchId == Model.MatchId)
                        {
                            <option value="@m.MatchId" selected>
                                مطابقة #@m.MatchId —
                                @m.MatchPercentage% — @m.Status
                            </option>
                        }
                        else
                        {
                            <option value="@m.MatchId">
                                مطابقة #@m.MatchId —
                                @m.MatchPercentage% — @m.Status
                            </option>
                        }
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CenterId" class="form-label fw-bold">
                المركز
            </label>
            <select asp-for="CenterId" class="form-select">
                <option value="">-- اختر --</option>
                @if (centers != null)
                {
                    foreach (var c in centers)
                    {
                        if (c.CenterId == Model.CenterId)
                        {
                            <option value="@c.CenterId" selected>
                                @c.CenterName — @c.LocationText
                            </option>
                        }
                        else
                        {
                            <option value="@c.CenterId">
                                @c.CenterName — @c.LocationText
                            </option>
                        }
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="DoctorNotes"
                   class="form-label fw-bold">
                ملاحظات الطبيب
            </label>
            <textarea asp-for="DoctorNotes"
                          class="form-control" rows="3">
            </textarea>
            </div>

            <div class="mb-4">
                <label asp-for="PatientFeedback"
                       class="form-label fw-bold">
                    ملاحظات المريض
                </label>
                <textarea asp-for="PatientFeedback"
                              class="form-control" rows="3">
            </textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
                    </button>
                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-right me-1"></i> رجوع
                    </a>
                </div>
            </form>
        </div>