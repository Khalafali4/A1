@{
    ViewData["Title"] = "إضافة تقرير زيارة";

    var patients = ViewData["Patients"]
        as IEnumerable<Da3m.Domain.User>
        ?? new List<Da3m.Domain.User>();

    var centers = ViewData["Centers"]
        as IEnumerable<Da3m.Domain.Center>
        ?? new List<Da3m.Domain.Center>();

    int selPatient = (int)(ViewBag.SelectedPatientId ?? 0);

    var matchesList = ViewBag.MatchesList as dynamic
        ?? new List<object>();
}

<div class="page-header">
    <h2>
        <i class="bi bi-file-medical me-2"></i>
        إضافة تقرير زيارة
    </h2>
    <p>سجّل زيارة طبية للمريض</p>
</div>

<div class="da3m-table p-4" style="max-width:680px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- الخطوة 1 — المريض -->
        <div class="mb-4">
            <label class="form-label fw-bold">
                <span class="badge-status me-1"
                      style="background:#E3F2FD;
                             color:#1565C0">1</span>
                اختر المريض
            </label>
            <select name="patientId"
                    class="form-select"
                    onchange="this.form.submit()">
                <option value="">-- اختر المريض --</option>
                @foreach (Da3m.Domain.User u in patients)
                {
                    if (u.UserId == selPatient)
                    {
                        <option value="@u.UserId" selected>
                            @u.FullName
                        </option>
                    }
                    else
                    {
                        <option value="@u.UserId">
                            @u.FullName
                        </option>
                    }
                }
            </select>
        </div>

        @if (selPatient > 0)
        {
            <!-- الخطوة 2 — المطابقة -->
            <div class="mb-4">
                <label class="form-label fw-bold">
                    <span class="badge-status me-1"
                          style="background:#E3F2FD;
                                 color:#1565C0">2</span>
                    اختر المطابقة
                </label>
                @if (matchesList != null &&
                    ((IEnumerable<dynamic>)matchesList).Any())
                {
                    <select name="MatchId" class="form-select"
                            required>
                        <option value="">
                            -- اختر المطابقة --
                        </option>
                        @foreach (var m in
                            (IEnumerable<dynamic>)matchesList)
                        {
                            <option value="@m.MatchId">
                                جهاز: @m.DeviceName —
                                @m.MatchPercentage% —
                                @m.Status —
                                @m.Date
                            </option>
                        }
                    </select>
                }
                else
                {
                    <div class="alert alert-warning py-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        لا توجد مطابقات لهذا المريض
                    </div>
                }
            </div>

            <!-- الخطوة 3 — المركز -->
            <div class="mb-4">
                <label class="form-label fw-bold">
                    <span class="badge-status me-1"
                          style="background:#E3F2FD;
                                 color:#1565C0">3</span>
                    المركز
                </label>
                <select name="CenterId" class="form-select"
                        required>
                    <option value="">-- اختر المركز --</option>
                    @foreach (Da3m.Domain.Center c in centers)
                    {
                        <option value="@c.CenterId">
                            @c.CenterName
                        </option>
                    }
                </select>
            </div>
            <!-- الخطوة 4 — ملاحظات الطبيب -->
            <div class="mb-4">
                <label class="form-label fw-bold">
                    <span class="badge-status me-1"
                          style="background:#E3F2FD;
                    color:#1565C0">4</span>
                    ملاحظات الطبيب
                </label>
                <textarea name="DoctorNotes"
                          class="form-control" rows="4"
                          placeholder="أدخل ملاحظاتك الطبية...">
                </textarea>
            </div>

            <!-- الخطوة 5 — ملاحظات المريض -->
            <div class="mb-4">
                <label class="form-label fw-bold">
                    <span class="badge-status me-1"
                          style="background:#F3E5F5;
                    color:#6A1B9A">5</span>
                    ملاحظات المريض (اختياري)
                </label>
                <textarea name="PatientFeedback"
                          class="form-control" rows="3"
                          placeholder="ملاحظات المريض...">
                </textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" name="action"
                        value="save"
                        class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    حفظ التقرير
                </button>
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i>
                    رجوع
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                اختر المريض أولاً لعرض مطابقاته
            </div>
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        }
    </form>
</div>