@model Da3m.Domain.VisitReport
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إضافة تقرير زيارة";
    var matches = ViewData["Matches"]
                  as IEnumerable<Da3m.Domain.Match>;
    var centers = ViewData["Centers"]
                  as IEnumerable<Da3m.Domain.Center>;
}

<div class="page-header">
    <h2>
        <i class="bi bi-file-medical me-2"></i>
        إضافة تقرير زيارة
    </h2>
    <p>سجّل تقرير زيارة المريض للمركز</p>
</div>

<div class="da3m-table p-4" style="max-width:650px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="MatchId" class="form-label fw-bold">
                المطابقة
            </label>
            <select asp-for="MatchId" class="form-select">
                <option value="">-- اختر المطابقة --</option>
                @if (matches != null)
                {
                    foreach (var m in matches)
                    {
                        <option value="@m.MatchId">
                            مطابقة #@m.MatchId —
                            @m.MatchPercentage% —
                            @m.Status
                        </option>
                    }
                }
            </select>
            <span asp-validation-for="MatchId"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CenterId" class="form-label fw-bold">
                المركز
            </label>
            <select asp-for="CenterId" class="form-select">
                <option value="">-- اختر المركز --</option>
                @if (centers != null)
                {
                    foreach (var c in centers)
                    {
                        <option value="@c.CenterId">
                            @c.CenterName — @c.LocationText
                        </option>
                    }
                }
            </select>
            <span asp-validation-for="CenterId"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DoctorNotes"
                   class="form-label fw-bold">
                ملاحظات الطبيب
            </label>
            <textarea asp-for="DoctorNotes"
                      class="form-control" rows="3"
                          placeholder="أدخل ملاحظات الطبيب...">
            </textarea>
            </div>

            <div class="mb-4">
                <label asp-for="PatientFeedback"
                       class="form-label fw-bold">
                    ملاحظات المريض
                </label>
                <textarea asp-for="PatientFeedback"
                          class="form-control" rows="3"
                              placeholder="أدخل ملاحظات المريض...">
            </textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> حفظ التقرير
                    </button>
                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-right me-1"></i> رجوع
                    </a>
                </div>
            </form>
        </div>