@model IEnumerable<Da3m.Domain.PatientDetail>
@{
    ViewData["Title"] = "المرضى";

    var patientDict = ViewData["PatientDict"]
                      as Dictionary<int, string>
                      ?? new Dictionary<int, string>();

}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-person-heart me-2"></i>المرضى</h2>
        <p>قائمة  المرضى المسجلين في المنصة</p>
    </div>
    @if (ViewBag.CurrentUserRole?.ToString().ToLower() == "admin" || ViewBag.CurrentUserRole?.ToString().ToLower() == "مدير")
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> إضافة مريض
        </a>
    }
    
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد مرضى مسجلون حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المريض</th>
                    <th>الرقم الوطني</th>
                    <th>تاريخ الميلاد</th>
                    <th>الجنس</th>
                    <th>العنوان</th>
                    <th>نوع الإعاقة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.PatientDetail patient in Model)
                {
                    @* var uName = usersDict.ContainsKey(doctor.UserId) ? usersDict[doctor.UserId] : "—"; *@
                    var pName = patientDict.ContainsKey(patient.UserId) ? patientDict[patient.UserId] : "-";
                    <tr>
                        <td>@patient.UserId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                    font-size:.8rem">
                                    @pName.Substring(0, 1)
                                </div>
                                <span class="fw-bold">@pName</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#FFF3E0;
                                color:#E65100">
                                @patient.NationalId
                            </span>
                        </td>
                        <td>@patient.BirthDate.ToString("yyyy/MM/dd")</td>
                        <td>@(patient.Gender ?? "—")</td>
                        <td>@(patient.Address ?? "—")</td>
                        <td>
                            @if (patient.DisabilityType != null)
                            {
                                <span class="badge-status"
                                      style="background:#FCE4EC;
                                    color:#AD1457">
                                    @patient.DisabilityType
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details"
                                       asp-route-id="@patient.UserId"
                                       class="btn btn-sm btn-outline-info"
                                       title="تفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @* @if (ViewBag.CurrentUserRole?.ToString().ToLower() == "admin" || ViewBag.CurrentUserRole?.ToString().ToLower() == "مدير") *@
                                @* { *@
                                <a asp-action="Edit"
                                       asp-route-id="@patient.UserId"
                                       class="btn btn-sm btn-outline-warning"
                                       title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@patient.UserId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                                @* } *@
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}