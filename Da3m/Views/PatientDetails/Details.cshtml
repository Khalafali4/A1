@model Da3m.Domain.PatientDetail
@{
    ViewData["Title"] = "تفاصيل المريض";
}

<div class="page-header">
    <h2>
        <i class="bi bi-person-heart me-2"></i>
        تفاصيل المريض
    </h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <div class="row g-3">
        <div class="col-6">
            <div class="text-muted" style="font-size:.82rem">
                الرقم الوطني
            </div>
            <div class="fw-bold">@Model.NationalId</div>
        </div>
        <div class="col-6">
            <div class="text-muted" style="font-size:.82rem">
                تاريخ الميلاد
            </div>
            <div class="fw-bold">
                @Model.BirthDate.ToString("yyyy/MM/dd")
            </div>
        </div>
        <div class="col-6">
            <div class="text-muted" style="font-size:.82rem">
                الجنس
            </div>
            <div class="fw-bold">@(Model.Gender ?? "—")</div>
        </div>
        <div class="col-6">
            <div class="text-muted" style="font-size:.82rem">
                العنوان
            </div>
            <div class="fw-bold">@(Model.Address ?? "—")</div>
        </div>
        <div class="col-12">
            <div class="text-muted" style="font-size:.82rem">
                نوع الإعاقة
            </div>
            <div class="fw-bold">
                @(Model.DisabilityType ?? "—")
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index"
               class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> رجوع
        </a>
        @if (ViewBag.CurrentRole?.ToString().ToLower() == "admin"
                          || ViewBag.CurrentRole?.ToString() == "مدير")
        {
            <a asp-action="Edit"
                   asp-route-id="@Model.UserId"
                   class="btn btn-warning ms-2">
                <i class="bi bi-pencil me-1"></i> تعديل
            </a>
        }
    </div>
</div>