@model Da3m.Domain.PatientDetail
@{
    ViewData["Title"] = "تعديل بيانات المريض";
}

<div class="page-header">
    <h2><i class="bi bi-person-heart me-2"></i>تعديل بيانات المريض</h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="NationalId" class="form-label fw-bold">
                الرقم الوطني
            </label>
            <input asp-for="NationalId" class="form-control" />
            <span asp-validation-for="NationalId"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label fw-bold">
                تاريخ الميلاد
            </label>
            <input asp-for="BirthDate" type="date"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label fw-bold">
                الجنس
            </label>
            <select asp-for="Gender" class="form-select">
                <option value="">-- اختر --</option>
                <option value="ذكر">ذكر</option>
                <option value="أنثى">أنثى</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label fw-bold">
                العنوان
            </label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="mb-4">
            <label asp-for="DisabilityType" class="form-label fw-bold">
                نوع الإعاقة
            </label>
            <input asp-for="DisabilityType" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>