@model Da3m.Domain.PatientDetail
@{
    ViewData["Title"] = "إضافة بيانات المريض";
}

<div class="page-header">
    <h2><i class="bi bi-person-heart me-2"></i>إكمال بيانات المريض</h2>
    <p>أدخل البيانات الطبية للمريض</p>
</div>

<!-- شريط التقدم -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center
            justify-content-center"
             style="width:32px;height:32px;
            background:#2E7D32;color:white;font-weight:700">
            ✓
        </div>
        <span class="text-muted" style="font-size:.88rem">
            تم إنشاء الحساب
        </span>
        <div style="flex:1;height:2px;background:#E0E0E0">
            <div style="width:50%;height:100%;
            background:#E65100"></div>
        </div>
        <div class="rounded-circle d-flex align-items-center
            justify-content-center"
             style="width:32px;height:32px;
            background:#E65100;color:white;font-weight:700">
            2
        </div>
        <span style="font-size:.88rem;font-weight:700;
            color:#E65100">
            بيانات المريض
        </span>
    </div>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-controller="PatientDetails" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values
                                            .SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
        <div class="mb-3">
            <label asp-for="NationalId" class="form-label fw-bold">
                الرقم الوطني
            </label>
            <input asp-for="NationalId" class="form-control"
                   placeholder="أدخل الرقم الوطني" />
            <span asp-validation-for="NationalId"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label fw-bold">
                تاريخ الميلاد
            </label>
            <input asp-for="BirthDate" type="date"
                   class="form-control" />
            <span asp-validation-for="BirthDate"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label fw-bold">
                الجنس
            </label>
            <select asp-for="Gender" class="form-select">
                <option value="">-- اختر --</option>
                <option value="ذكر">ذكر</option>
                <option value="أنثى">أنثى</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label fw-bold">
                العنوان
            </label>
            <input asp-for="Address" class="form-control"
                   placeholder="المدينة، الحي" />
        </div>

        <div class="mb-4">
            <label asp-for="DisabilityType" class="form-label fw-bold">
                نوع الإعاقة
            </label>
            <input asp-for="DisabilityType" class="form-control"
                   placeholder="مثال: بتر الطرف السفلي" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i> إكمال التسجيل
            </button>
            <a asp-controller="Users" asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>