@model IEnumerable<Da3m.Domain.Role>
@{
    ViewData["Title"] = "الأدوار";
    var usersCount = ViewData["UsersCount"] as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-shield-fill me-2"></i>الأدوار</h2>
        <p>إدارة أدوار المستخدمين</p>
     
        <a asp-action="Deleted" class="btn btn-outline-warning">
            <i class="bi bi-archive  me-1"></i> الأدوار الموقوفة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            لا توجد أدوار مسجلة حالياً
        </div>
    }
    else
    {
        <div class="da3m-table">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم الدور</th>
                        <th>عدد المستخدمين</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Da3m.Domain.Role role in Model)
                    {
                        int count = usersCount.ContainsKey(role.RoleId) ? usersCount[role.RoleId] : 0;
                       
                       
                        <tr>
                           
                            <td>@role.RoleId</td>
                            <td>
                                <span class="badge-status"
                                      style="background:#E3F2FD;
                                    color:#1565C0">
                                    <i class="bi bi-shield me-1"></i>
                                    @role.RoleName
                                </span>
                            </td>
                            <td>
                                @if(count > 0)
                                {
                                <span class="badge-status" style="background:auto ; color:#1565c0">
                                    <i class="bi bi-people-fill" ; style="background:#E3F2FD ; color:#1565c0"></i>
                                    @count مستخدم
                                </span>
                                }
                                else
                                {
                                    <span class="text-muted"></span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit"
                                           asp-route-id="@role.RoleId"
                                           class="btn btn-sm btn-outline-warning"
                                           title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete"
                                          asp-route-id="@role.RoleId"
                                          method="post"
                                          style="display:inline"
                                          onsubmit="return confirm('أيقاف هذا الدور ؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="إيقاف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }