@model IEnumerable<Da3m.Domain.Role>
@{
    ViewData["Title"] = "الأدوار";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-shield-fill me-2"></i>الأدوار</h2>
        <p>إدارة أدوار المستخدمين في المنصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة دور
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد أدوار مسجلة حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم الدور</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Role role in Model)
                {
                    <tr>
                        <td>@role.RoleId</td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E3F2FD;
                                color:#1565C0">
                                <i class="bi bi-shield me-1"></i>
                                @role.RoleName
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                       asp-route-id="@role.RoleId"
                                       class="btn btn-sm btn-outline-warning"
                                       title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@role.RoleId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}