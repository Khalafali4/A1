@model Da3m.Domain.Role
@{
    ViewData["Title"] = "إضافة دور";
}

<div class="page-header">
    <h2><i class="bi bi-shield-plus me-2"></i>إضافة دور جديد</h2>
    <p>أدخل اسم الدور الجديد</p>
</div>

<div class="da3m-table p-4" style="max-width:500px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label asp-for="RoleName" class="form-label fw-bold">
                اسم الدور
            </label>
            <input asp-for="RoleName" class="form-control"
                   placeholder="مثال: طبيب، مريض، متبرع" />
            <span asp-validation-for="RoleName"
                  class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> حفظ
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>