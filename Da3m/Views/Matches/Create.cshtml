@model Da3m.Domain.Match
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إضافة مطابقة";
    decimal pct = ViewBag.Percentage != null ? (decimal)ViewBag.Percentage : 0m;
    string color = pct >= 80 ? "#2E7D32" : pct >= 60 ? "#E65100" : "#C62828";
    string bg    = pct >= 80 ? "#E8F5E9" : pct >= 60 ? "#FFF3E0" : "#FFEBEE";
    string label = pct >= 80 ? "مطابقة ممتازة" : pct >= 60 ? "مطابقة جيدة" : "مطابقة ضعيفة";

    var patients = ViewData["Patients"] as IEnumerable<Da3m.Domain.User>;
    var devices  = ViewData["Devices"]  as IEnumerable<Da3m.Domain.Prostheses>;

    int selPatient = Model?.UserId   ?? 0;
    int selDevice  = Model?.DeviceId ?? 0;
}

<div class="page-header">
    <h2><i class="bi bi-shuffle me-2"></i>إضافة مطابقة جديدة</h2>
    <p>طابق مريضاً بجهاز تعويضي مناسب</p>
</div>

<div class="da3m-table p-4" style="max-width:650px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- المريض -->
        <!-- المريض -->
        <div class="mb-3">
            <label class="form-label fw-bold">المريض</label>

            @if (ViewBag.IsPatient == true)
            {
                <!-- ✅ المريض — يظهر اسمه فقط بدون اختيار -->
                <div class="alert alert-info py-2">
                    <i class="bi bi-person-check me-2"></i>
                    <strong>@ViewBag.PatientName</strong>
                </div>
                <input type="hidden" name="UserId"
                       value="@Model.UserId" />
            }
            else
            {
                <!-- Admin + Doctor — يختار المريض -->
                <select name="UserId" class="form-select"
                        onchange="this.form.submit()">
                    <option value="">-- اختر المريض --</option>
                    @if (ViewData["Patients"] != null)
                    {
                        foreach (var u in ViewData["Patients"]
                            as IEnumerable<Da3m.Domain.User>)
                        {
                            if (u.UserId == selPatient)
                            {
                                <option value="@u.UserId" selected>
                                    @u.FullName
                                </option>
                            }
                            else
                            {
                                <option value="@u.UserId">
                                    @u.FullName
                                </option>
                            }
                        }
                    }
                </select>
            }
        </div>

        <!-- الجهاز -->
        @{
            var measurements = ViewBag.PatientMeasurements as List<Da3m.Domain.Measurement> ?? new List<Da3m.Domain.Measurement>();
            int selMeasurement = ViewBag.SelectedMeasurementId ?? 0;
        }
        @if (measurements.Any())
        {
            <div class="mb-3">
                <label class="form-label fw-bold">
                    المقاس المستخدم للمطابقة
                </label>
                <select name="measurementId" class="form-select"
                        onchange="this.form.submit()">
                    <option value="">-- اختر المقاس --</option>
                    @foreach (Da3m.Domain.Measurement m in measurements)
                    {
                        var txt = m.LimbType + " — "
                            + m.LengthCm + "×" + m.WidthCm
                            + " cm — "
                            + m.MeasuredAt.ToString("yyyy/MM/dd");

                        if (m.MeasurementId == selMeasurement)
                        {
                            <option value="@m.MeasurementId"
                                    selected>
                                @txt (الأحدث)
                            </option>
                        }
                        else
                        {
                            <option value="@m.MeasurementId">
                                @txt
                            </option>
                        }
                    }
                </select>
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    المقاسات مرتبة من الأحدث للأقدم
                </small>
            </div>
        }
        else if (selPatient > 0)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                لا توجد مقاسات لهذا المريض —
                <a asp-controller="Measurements"
                       asp-action="Create">
                    أضف مقاساً أولاً
                </a>
            </div>
        }

        <!-- نسبة المطابقة -->
        @if (pct > 0)
        {
            <!-- نسبة المطابقة -->
            <div class="mb-4 p-3 rounded text-center"
                 style="background:@bg">
                <div style="font-size:3rem;font-weight:900;color:@color">
                    @pct%
                </div>
                <div style="font-weight:700;color:@color">@label</div>
            </div>
            <input type="hidden" name="MatchPercentage" value="@pct" />
            <div class="d-flex gap-2">
                <button type="submit" name="action"
                        value="save" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> حفظ المطابقة
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i> رجوع
                </a>
            </div>
        }
        else if (selPatient > 0 && selDevice > 0)
        {
            <!-- ✅ رسالة عدم التطابق -->
            <div class="alert alert-danger">
                <i class="bi bi-x-circle me-2"></i>
                <strong>لا يوجد تطابق</strong> —
                نوع الطرف المطلوب للمريض لا يتوافق مع هذا الجهاز
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                اختر المريض والجهاز لحساب النسبة تلقائياً
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        }
    </form>
</div>