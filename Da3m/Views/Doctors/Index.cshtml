@model IEnumerable<Da3m.Domain.Doctor>
@{
    ViewData["Title"] = "الأطباء";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-person-badge-fill me-2"></i>الأطباء</h2>
        <p>إدارة جميع الأطباء المسجلين في المنصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة طبيب
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد أطباء مسجلون حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover" style="table-layout:auto; width:100%" >
            <thead>
                <tr>
                    <th>#</th>
                    <th>التخصص</th>
                    <th>رقم الترخيص</th>
                    <th>المستشفى</th>
                    <th style="width:20%">المركز</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Doctor doctor in Model)
                {
                    <tr>
                        <td>@doctor.UserId</td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E8F5E9;
                                color:#2E7D32">
                                @(doctor.Specialty ?? "—")
                            </span>
                        </td>
                        <td>@(doctor.LicenseNumber ?? "—")</td>
                        <td>@(doctor.HospitalName ?? "—")</td>
                        <td>
                            @{
                                var centers = ViewData["Center"] as Dictionary<int, string>;
                                string centerName = "—";
                                if (centers != null && doctor.CenterId.HasValue)
                                {
                                    int key = doctor.CenterId.Value;
                                    if(centers.ContainsKey(key))
                                    centerName = centers[key];
                                }
                            }
                            @if(centerName != "-")
                            {
                                <span class="badge-status"
                                      style="background:#E3F2FD; color:#1565C0">
                                    <i class="bi bi-hospital me-1"></i>@centerName
                                </span>
                          
                            }
                            else
                            {

                                <span class="text-muted"></span>
                            
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                       asp-route-id="@doctor.UserId"
                                       class="btn btn-sm btn-outline-warning"
                                       title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@doctor.UserId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}