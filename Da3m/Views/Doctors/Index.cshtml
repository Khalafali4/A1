@model IEnumerable<Da3m.Domain.Doctor>
@{
    ViewData["Title"] = "الأطباء";
    var usersDict = ViewData["UsersDict"]
                      as Dictionary<int, string>
                      ?? new Dictionary<int, string>();

    var centersDict = ViewData["CentersDict"]
                      as Dictionary<int, string>
                      ?? new Dictionary<int, string>();

    bool isAdmin = ViewBag.CurrentRole?.ToString()
                       .ToLower() == "admin"
                || ViewBag.CurrentRole?.ToString() == "مدير";
}

<div class="page-header d-flex justify-content-between
    align-items-center">
    <div>
        <h2>
            <i class="bi bi-person-badge-fill me-2"></i>
            الأطباء
        </h2>
        <p>إدارة الأطباء المسجلين في المنصة</p>
    </div>
    @if (isAdmin)
    {
       <div>
            <a asp-action="Delete"
                   class="btn btn-outline-warning">
                <i class="bi bi-archive me-1"></i>
                الموقوفون
            </a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد أطباء مسجلون حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الطبيب</th>
                    <th>التخصص</th>
                    <th>رقم الترخيص</th>
                    <th>المستشفى</th>
                    <th>المركز</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Doctor doctor in Model)
                {
                    var uName = usersDict.ContainsKey(doctor.UserId) ? usersDict[doctor.UserId] : "—";
                    var cName = doctor.CenterId.HasValue &&
                        centersDict.ContainsKey(doctor.CenterId.Value)
                        ? centersDict[doctor.CenterId.Value] : "—";

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                    font-size:.8rem">
                                    @uName.Substring(0, 1)
                                </div>
                                <span class="fw-bold">@uName</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E8F5E9;
                                color:#2E7D32">
                                @(doctor.Specialty ?? "—")
                            </span>
                        </td>
                        <td>@(doctor.LicenseNumber ?? "—")</td>
                        <td>@(doctor.HospitalName ?? "—")</td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E3F2FD;
                                color:#1565C0">
                                @cName
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details"
                                       asp-route-id="@doctor.UserId"
                                       class="btn btn-sm btn-outline-info"
                                       title="تفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit"
                                           asp-route-id="@doctor.UserId"
                                           class="btn btn-sm btn-outline-warning"
                                           title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete"
                                          asp-route-id="@doctor.UserId"
                                          method="post"
                                          style="display:inline"
                                          onsubmit="return confirm(
                                        'إيقاف هذا الطبيب؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning"
                                                title="إيقاف">
                                            <i class="bi bi-person-slash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}