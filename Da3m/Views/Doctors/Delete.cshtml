@model IEnumerable<Da3m.Domain.Doctor>
@{
    ViewData["Title"] = "الأطباء الموقوفون";
    var usersDict = ViewData["UsersDict"]
                    as Dictionary<int, string>
                    ?? new Dictionary<int, string>();
}

<div class="page-header d-flex justify-content-between
    align-items-center">
    <div>
        <h2>
            <i class="bi bi-archive me-2"></i>
            الأطباء الموقوفون
        </h2>
        <p>يمكنك استعادتهم في أي وقت</p>
    </div>
    <a asp-action="Index"
           class="btn btn-outline-primary">
        <i class="bi bi-arrow-right me-1"></i>
        الأطباء النشطون
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد أطباء موقوفون
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الطبيب</th>
                    <th>التخصص</th>
                    <th>المستشفى</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Doctor doctor in Model)
                {
                    var uName = usersDict
                        .ContainsKey(doctor.UserId)
                        ? usersDict[doctor.UserId] : "—";

                    <tr style="opacity:.7">
                        <td>
                            <div class="d-flex
                                align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                    font-size:.8rem;
                                    background:#FFEBEE">
                                    <span style="color:#C62828">
                                        @uName.Substring(0, 1)
                                    </span>
                                </div>
                                <span>@uName</span>
                            </div>
                        </td>
                        <td>@(doctor.Specialty ?? "—")</td>
                        <td>@(doctor.HospitalName ?? "—")</td>
                        <td>
                            <form asp-action="Restore"
                                  asp-route-id="@doctor.UserId"
                                  method="post"
                                  style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-success">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    استعادة
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
