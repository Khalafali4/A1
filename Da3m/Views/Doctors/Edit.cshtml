@model Da3m.Domain.Doctor
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "تعديل بيانات الطبيب";
}

<div class="page-header">
    <h2><i class="bi bi-person-badge-fill me-2"></i>تعديل بيانات الطبيب</h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="Specialty" class="form-label fw-bold">
                التخصص
            </label>
            <input asp-for="Specialty" class="form-control"
                   placeholder="مثال: جراحة العظام" />
            <span asp-validation-for="Specialty"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LicenseNumber" class="form-label fw-bold">
                رقم الترخيص
            </label>
            <input asp-for="LicenseNumber" class="form-control" />
            <span asp-validation-for="LicenseNumber"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="HospitalName" class="form-label fw-bold">
                اسم المستشفى
            </label>
            <input asp-for="HospitalName" class="form-control" />
            <span asp-validation-for="HospitalName"
                  class="text-danger small"></span>
        </div>

        <!-- ✅ اختيار المركز -->
        <div class="mb-4">
            <label asp-for="CenterId" class="form-label fw-bold">
                المركز
            </label>
            <select asp-for="CenterId" class="form-select"
                    asp-items="@(new SelectList((IEnumerable<Da3m.Domain.Center>)ViewBag.Centers,"CenterId","CenterName",Model.CenterId))">
                <option value="">-- بدون مركز --</option>
            </select>
            <span asp-validation-for="CenterId"
                  class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>