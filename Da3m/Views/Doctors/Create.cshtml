@model Da3m.Domain.Doctor
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إضافة بيانات الطبيب";
}

<div class="page-header">
    <h2>
        <i class="bi bi-person-badge-fill me-2"></i>
        إكمال بيانات الطبيب
    </h2>
    <p>أدخل البيانات الطبية للمستخدم المسجل</p>
</div>

<!-- شريط التقدم -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="rounded-circle d-flex align-items-center
            justify-content-center"
             style="width:32px;height:32px;
            background:#2E7D32;color:white;
            font-size:.85rem;font-weight:700">
            ✓
        </div>
        <span class="text-muted" style="font-size:.88rem">
            تم إنشاء الحساب
        </span>
        <div style="flex:1;height:2px;background:#E0E0E0">
            <div style="width:50%;height:100%;
            background:#1565C0"></div>
        </div>
        <div class="rounded-circle d-flex align-items-center
            justify-content-center"
             style="width:32px;height:32px;
            background:#1565C0;color:white;
            font-size:.85rem;font-weight:700">
            2
        </div>
        <span style="font-size:.88rem;font-weight:700;
            color:#1565C0">
            بيانات الطبيب
        </span>
    </div>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- ✅ مخفي يحمل UserId -->
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="Specialty" class="form-label fw-bold">
                التخصص
            </label>
            <input asp-for="Specialty" class="form-control"
                   placeholder="مثال: جراحة العظام" />
            <span asp-validation-for="Specialty"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LicenseNumber" class="form-label fw-bold">
                رقم الترخيص
            </label>
            <input asp-for="LicenseNumber" class="form-control"
                   placeholder="أدخل رقم الترخيص الطبي" />
            <span asp-validation-for="LicenseNumber"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="HospitalName" class="form-label fw-bold">
                اسم المستشفى
            </label>
            <input asp-for="HospitalName" class="form-control"
                   placeholder="اسم المستشفى أو العيادة" />
            <span asp-validation-for="HospitalName"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="CenterId" class="form-label fw-bold">
                المركز (اختياري)
            </label>
            <select asp-for="CenterId" class="form-select"
                    asp-items="@(new SelectList((IEnumerable<Da3m.Domain.Center>)ViewBag.Centers, "CenterId", "CenterName"))">
                <option value="">-- اختر المركز --</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i> إكمال التسجيل
            </button>
            <a asp-controller="Users" asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>