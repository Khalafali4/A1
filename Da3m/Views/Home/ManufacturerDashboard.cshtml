@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="page-header">
    <h2>
        <i class="bi bi-building me-2"></i>
        مرحباً @ViewBag.CurrentUser
    </h2>
    <p>لوحة تحكم المصنّع</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto mb-2"
                 style="background:#F3E5F5">
                <i class="bi bi-robot"
                   style="color:#6A1B9A"></i>
            </div>
            <div class="stat-num">
                @(ViewBag.MyDevicesCount ?? 0)
            </div>
            <div class="stat-label">إجمالي أجهزتي</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto mb-2"
                 style="background:#E8F5E9">
                <i class="bi bi-check-circle"
                   style="color:#2E7D32"></i>
            </div>
            <div class="stat-num">
                @(ViewBag.AvailableDevices ?? 0)
            </div>
            <div class="stat-label">أجهزة متاحة</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card text-center">
            <div class="stat-icon mx-auto mb-2"
                 style="background:#FFEBEE">
                <i class="bi bi-x-circle"
                   style="color:#C62828"></i>
            </div>
            <div class="stat-num">
                @(ViewBag.UnavailableDevices ?? 0)
            </div>
            <div class="stat-label">أجهزة غير متاحة</div>
        </div>
    </div>
</div>

<div class="da3m-table p-3">
    <h6 class="fw-bold text-primary mb-3">
        <i class="bi bi-lightning-fill me-1"></i>
        وصول سريع
    </h6>
    <div class="d-flex gap-2">
        <a asp-controller="Prostheses"
               asp-action="Create"
               class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>
            إضافة أجهزة جديدة
        </a>
        <a asp-controller="Prostheses"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list me-1"></i>
            عرض أجهزتي
        </a>
    </div>
</div>