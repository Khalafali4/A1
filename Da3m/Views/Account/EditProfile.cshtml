@model Da3m.Domain.User
@{
    ViewData["Title"] = "تعديل بياناتي";
}

<div class="page-header">
    <h2>
        <i class="bi bi-person-gear me-2"></i>
        تعديل بياناتي الأساسية
    </h2>
    <p>عدّل معلوماتك الشخصية</p>
</div>

<div class="da3m-table p-4" style="max-width:550px">
    <form asp-action="EditProfile" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="RoleId" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="IsDeleted" />

        <div class="mb-3">
            <label asp-for="FullName"
                   class="form-label fw-bold">
                الاسم الكامل
            </label>
            <input asp-for="FullName"
                   class="form-control" />
            <span asp-validation-for="FullName"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email"
                   class="form-label fw-bold">
                البريد الإلكتروني
            </label>
            <input asp-for="Email"
                   class="form-control" />
            <span asp-validation-for="Email"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone"
                   class="form-label fw-bold">
                رقم الهاتف
            </label>
            <input asp-for="Phone"
                   class="form-control" />
            <span asp-validation-for="Phone"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password"
                   class="form-label fw-bold">
                كلمة المرور
            </label>
            <input asp-for="Password" type="password"
                   class="form-control"
                   placeholder="اتركها فارغة إذا لم تريد تغييرها" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-check-lg me-1"></i>
                حفظ التعديلات
            </button>
            <a asp-action="Profile"
                   class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>