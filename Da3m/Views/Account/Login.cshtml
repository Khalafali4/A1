@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>دعم — تسجيل الدخول</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Cairo', sans-serif; }
        body {
            background: linear-gradient(135deg, #0D47A1 0%, #1565C0 50%, #00ACC1 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,.2);
        }
        .logo-box {
            width: 70px; height: 70px;
            background: linear-gradient(135deg, #1565C0, #00ACC1);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            margin: 0 auto 20px;
        }
        .form-control, .form-select {
            border-radius: 10px;
            padding: 12px 16px;
            border: 2px solid #E0E7EF;
            font-family: 'Cairo', sans-serif;
        }
        .form-control:focus, .form-select:focus {
            border-color: #1565C0;
            box-shadow: 0 0 0 3px rgba(21,101,192,.1);
        }
        .btn-auth {
            background: linear-gradient(135deg, #1565C0, #00ACC1);
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 1rem;
            font-weight: 700;
            color: white;
            width: 100%;
        }
        .btn-auth:hover { opacity: .9; color: white; }
        .input-icon { position: relative; }
        .input-icon i {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #7a8999;
        }
        .input-icon input { padding-right: 42px; }
        .divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 20px 0;
            color: #7a8999;
            font-size: .85rem;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #E0E7EF;
        }
    </style>
</head>
<body>
<div class="auth-card">
    <div class="logo-box">
        <i class="bi bi-heart-pulse-fill"></i>
    </div>
    <h4 class="text-center fw-bold mb-1" style="color:#0D47A1">
        منصة دعم
    </h4>
    <p class="text-center text-muted mb-4" style="font-size:.88rem">
        سجّل دخولك للمتابعة
    </p>
    @* var user = users.FirstOrDefault(); *@
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger py-2"
             style="font-size:.88rem;border-radius:10px">
            <i class="bi bi-exclamation-circle me-1"></i>
            @ViewBag.Error
        </div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-bold" style="color:#374151">
                البريد الإلكتروني
            </label>
            <div class="input-icon">
                <i class="bi bi-envelope"></i>
                <input type="email" name="email"
                       class="form-control"
                       placeholder="example@mail.com"
                       required />
            </div>
        </div>
        <div class="mb-4">
            <label class="form-label fw-bold" style="color:#374151">
                كلمة المرور
            </label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <input type="password" name="password"
                       class="form-control"
                       placeholder="••••••••"
                       required />
            </div>
        </div>

        <button type="submit" class="btn btn-auth">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            تسجيل الدخول
        </button>
    </form>

    <div class="divider">أو</div>

    <a asp-action="Register"
       class="btn btn-outline-primary w-100"
       style="border-radius:10px;font-weight:700">
        <i class="bi bi-person-plus me-2"></i>
        إنشاء حساب جديد
    </a>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
