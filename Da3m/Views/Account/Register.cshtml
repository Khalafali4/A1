@{
    ViewData["Title"] = "إنشاء حساب";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>دعم — إنشاء حساب</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Cairo', sans-serif; }
        body {
            background: linear-gradient(135deg, #0D47A1 0%, #1565C0 50%, #00ACC1 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }
        .auth-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 60px rgba(0,0,0,.2);
        }
        .logo-box {
            width: 60px; height: 60px;
            background: linear-gradient(135deg, #1565C0, #00ACC1);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: white;
            margin: 0 auto 16px;
        }
        .form-control, .form-select {
            border-radius: 10px;
            padding: 11px 16px;
            border: 2px solid #E0E7EF;
            font-family: 'Cairo', sans-serif;
            font-size: .92rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #1565C0;
            box-shadow: 0 0 0 3px rgba(21,101,192,.1);
        }
        .btn-auth {
            background: linear-gradient(135deg, #1565C0, #00ACC1);
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: 1rem;
            font-weight: 700;
            color: white;
            width: 100%;
        }
        .btn-auth:hover { opacity: .9; color: white; }
        .input-icon { position: relative; }
        .input-icon i {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #7a8999;
        }
        .input-icon input,
        .input-icon select { padding-right: 42px; }
    </style>
</head>
<body>
<div class="auth-card">
    <div class="logo-box">
        <i class="bi bi-heart-pulse-fill"></i>
    </div>
    <h4 class="text-center fw-bold mb-1" style="color:#0D47A1">
        إنشاء حساب جديد
    </h4>
    <p class="text-center text-muted mb-4" style="font-size:.85rem">
        أدخل بياناتك لإنشاء حسابك
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger py-2"
             style="font-size:.88rem;border-radius:10px">
            <i class="bi bi-exclamation-circle me-1"></i>
            @ViewBag.Error
        </div>
    }

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-bold" style="color:#374151">
                الاسم الكامل
            </label>
            <div class="input-icon">
                <i class="bi bi-person"></i>
                <input type="text" name="fullName"
                       class="form-control"
                       placeholder="أدخل اسمك الكامل"
                       required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" style="color:#374151">
                البريد الإلكتروني
                </label>
            <div class="input-icon">
                <i class="bi bi-envelope"></i>
                <input type="email" name="email"
                       class="form-control"
                       placeholder="example@mail.com"
                       required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" style="color:#374151">
                رقم الهاتف
            </label>
            <div class="input-icon">
                <i class="bi bi-phone"></i>
                <input type="tel" name="phone"
                       class="form-control"
                       placeholder="09xxxxxxxx"
                       required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" style="color:#374151">
                الدور
            </label>
            <div class="input-icon">
                <i class="bi bi-shield"></i>
                <select name="roleId" class="form-select"
                        style="padding-right:42px" required>
                    <option value="">-- اختر الدور --</option>
                    @if (ViewBag.Roles != null)
                    {
                        foreach (Da3m.Domain.Role r in ViewBag.Roles)
                        {
                            <option value="@r.RoleId">
                                @r.RoleName
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold" style="color:#374151">
                كلمة المرور
            </label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <input type="password" name="password"
                       class="form-control"
                       placeholder="••••••••"
                       minlength="6"
                       required />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold" style="color:#374151">
                تأكيد كلمة المرور
            </label>
            <div class="input-icon">
                <i class="bi bi-lock-fill"></i>
                <input type="password" name="confirmPassword"
                       class="form-control"
                       placeholder="••••••••"
                       minlength="6"
                       required />
            </div>
        </div>

        <button type="submit" class="btn btn-auth mb-3">
            <i class="bi bi-person-check me-2"></i>
            إنشاء الحساب
        </button>

        <a asp-action="Login"
           class="btn btn-outline-secondary w-100"
           style="border-radius:10px;font-weight:700">
            <i class="bi bi-arrow-right me-2"></i>
            لدي حساب — تسجيل الدخول
        </a>
    </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>