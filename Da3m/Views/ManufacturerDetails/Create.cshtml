@model Da3m.Domain.ManufacturerDetail
@{
    ViewData["Title"] = "إضافة مصنّع";
}

<div class="page-header">
    <h2><i class="bi bi-building me-2"></i>إكمال بيانات المصنّع</h2>
    <p>أدخل بيانات الشركة المصنّعة</p>
</div>

<!-- شريط التقدم -->
<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center
            justify-content-center"
             style="width:32px;height:32px;
            background:#2E7D32;color:white;font-weight:700">
            ✓
        </div>
        <span class="text-muted" style="font-size:.88rem">
            تم إنشاء الحساب
        </span>
        <div style="flex:1;height:2px;background:#E0E0E0">
            <div style="width:50%;height:100%;
            background:#1565C0"></div>
        </div>
        <div class="rounded-circle d-flex align-items-center
            justify-content-center"
             style="width:32px;height:32px;
            background:#1565C0;color:white;font-weight:700">
            2
        </div>
        <span style="font-size:.88rem;font-weight:700;
            color:#1565C0">
            بيانات الشركة
        </span>
    </div>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label fw-bold">
                اسم الشركة
            </label>
            <input asp-for="CompanyName" class="form-control"
                   placeholder="أدخل اسم الشركة" />
            <span asp-validation-for="CompanyName"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CommercialRegister"
                   class="form-label fw-bold">
                السجل التجاري
            </label>
            <input asp-for="CommercialRegister" class="form-control"
                   placeholder="رقم السجل التجاري" />
        </div>

        <div class="mb-4">
            <label asp-for="Website" class="form-label fw-bold">
                الموقع الإلكتروني
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-globe"></i>
                </span>
                <input asp-for="Website" class="form-control"
                       placeholder="https://example.com" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i> إكمال التسجيل
            </button>
            <a asp-controller="Users" asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>