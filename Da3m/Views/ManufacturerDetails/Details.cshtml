@model Da3m.Domain.ManufacturerDetail
@{
    ViewData["Title"] = "تفاصيل المصنّع";
    var devices = ViewBag.Devices
        as List<Da3m.Domain.Prostheses>
        ?? new List<Da3m.Domain.Prostheses>();
    int total     = (int)(ViewBag.DevicesCount     ?? 0);
    int available = (int)(ViewBag.AvailableCount   ?? 0);
    int unavail   = (int)(ViewBag.UnavailableCount ?? 0);
}

<div class="page-header d-flex justify-content-between
             align-items-center">
    <div>
        <h2>
            <i class="bi bi-building me-2"
               style="color:#6A1B9A"></i>
            @Model.CompanyName
        </h2>
        <p>تفاصيل الشركة المصنّعة</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> رجوع
        </a>
        <a asp-action="Edit"
           asp-route-id="@Model.UserId"
           class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i> تعديل
        </a>
    </div>
</div>

<div class="row g-3">

    <!-- بطاقة الشركة -->
    <div class="col-md-4">
        <div class="da3m-table p-4 text-center">
            <div style="width:80px;height:80px;
                        background:linear-gradient(
                            135deg,#6A1B9A,#8E24AA);
                        border-radius:20px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:2rem;
                        color:white;
                        margin:0 auto 16px">
                @Model.CompanyName.Substring(0, 1)
            </div>

            <h5 class="fw-bold mb-1"
                style="color:#4A148C">
                @Model.CompanyName
            </h5>
            <span class="badge-status d-inline-block mb-3"
                  style="background:#F3E5F5;color:#6A1B9A">
                <i class="bi bi-building me-1"></i>
                مصنّع
            </span>

            <hr />

            <div class="text-start">
                <div class="mb-3">
                    <div class="text-muted"
                         style="font-size:.78rem">
                        <i class="bi bi-person me-1"></i>
                        المسؤول
                    </div>
                    <div class="fw-bold"
                         style="font-size:.88rem">
                        @ViewBag.UserName
                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-muted"
                         style="font-size:.78rem">
                        <i class="bi bi-envelope me-1"></i>
                        البريد
                    </div>
                    <div class="fw-bold"
                         style="font-size:.88rem">
                        @ViewBag.UserEmail
                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-muted"
                         style="font-size:.78rem">
                        <i class="bi bi-phone me-1"></i>
                        الهاتف
                    </div>
                    <div class="fw-bold"
                         style="font-size:.88rem">
                        @ViewBag.UserPhone
                    </div>
                </div>
                @if (Model.CommercialRegister != null)
                {
                    <div class="mb-3">
                        <div class="text-muted"
                             style="font-size:.78rem">
                            <i class="bi bi-card-text me-1"></i>
                            السجل التجاري
                        </div>
                        <div class="fw-bold"
                             style="font-size:.88rem">
                             @Model.CommercialRegister
                        </div>
                    </div>
                }
                @if (Model.Website != null)
                {
                    <div>
                        <div class="text-muted"
                             style="font-size:.78rem">
                            <i class="bi bi-globe me-1"></i>
                            الموقع
                        </div>
                        <a href="@Model.Website"
                           target="_blank"
                           class="fw-bold"
                           style="font-size:.88rem;
                                  color:#1565C0">
                            @Model.Website
                        </a>
                    </div>
                }
            </div>

            <hr />

            <!-- إحصائيات -->
            <div class="row g-2">
                <div class="col-4">
                    <div class="p-2 rounded"
                         style="background:#F3E5F5">
                        <div class="fw-bold"
                             style="color:#6A1B9A;
                                    font-size:1.2rem">
                            @total
                        </div>
                        <div style="font-size:.7rem;
                                    color:#7a8999">
                            الكل
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 rounded"
                         style="background:#E8F5E9">
                        <div class="fw-bold"
                             style="color:#2E7D32;
                                    font-size:1.2rem">
                            @available
                        </div>
                        <div style="font-size:.7rem;
                                    color:#7a8999">
                            متاح
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 rounded"
                         style="background:#FFEBEE">
                        <div class="fw-bold"
                             style="color:#C62828;
                                    font-size:1.2rem">
                            @unavail
                        </div>
                        <div style="font-size:.7rem;
                                    color:#7a8999">
                            غير متاح
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- قائمة الأجهزة -->
    <div class="col-md-8">
        <div class="da3m-table">
            <div class="p-3 border-bottom d-flex
                         justify-content-between
                         align-items-center">
                <h6 class="fw-bold mb-0"
                    style="color:#6A1B9A">
                    <i class="bi bi-robot me-1"></i>
                    أجهزة الشركة (@total)
                </h6>
                <a asp-controller="Prostheses"
                   asp-action="Create"
                   class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    إضافة جهاز
                </a>
            </div>

            @if (!devices.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    لا توجد أجهزة مسجلة
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>نوع الطرف</th>
                            <th>الطول/العرض</th>
                            <th>الحالة</th>
                            <th>التوفر</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Da3m.Domain.Prostheses d
                            in devices)
                        {
                            var condBg = d.Condition == "جديد"
                                ? "#E8F5E9" : "#FFF3E0";
                            var condColor = d.Condition == "جديد"
                                ? "#2E7D32" : "#E65100";

                            <tr>
                                <td>
                                    <span class="badge-status"
                                          style="background:#F3E5F5;
                                        color:#6A1B9A;
                                        font-size:.78rem">
                                        @d.LimbType
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold"
                                          style="color:#1565C0;
                                        font-size:.85rem">
                                        @d.LengthCm
                                    </span>
                                    <span style="color:#7a8999">×</span>
                                    <span class="fw-bold"
                                          style="color:#1565C0;
                                        font-size:.85rem">
                                        @d.WidthCm cm
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-status"
                                          style="background:@condBg;
                                        color:@condColor;
                                        font-size:.78rem">
                                        @(d.Condition ?? "—")
                                    </span>
                                </td>
                                <td>
                                    @if (d.IsAvailable)
                                    {
                                        <span class="badge-status"
                                              style="background:#E8F5E9;
                                            color:#2E7D32;
                                            font-size:.78rem">
                                            <i class="bi bi-check-circle"></i>
                                            متاح
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status"
                                              style="background:#FFEBEE;
                                            color:#C62828;
                                            font-size:.78rem">
                                            <i class="bi bi-x-circle"></i>
                                            غير متاح
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>