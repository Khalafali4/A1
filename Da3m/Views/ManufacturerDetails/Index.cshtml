@model IEnumerable<Da3m.Domain.ManufacturerDetail>
@{
    ViewData["Title"] = "المصنّعون";
    var dict = ViewData["UsersDict"] as Dictionary<int, string>;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-building me-2"></i>المصنّعون</h2>
        <p>إدارة جميع المصنّعين المسجلين في المنصة</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد مصنّعون مسجلون حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم المستخدم</th>
                    <th>اسم الشركة</th>
                    <th>السجل التجاري</th>
                    <th>الموقع</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.ManufacturerDetail m in Model)
                {
                    var uName = "—";
                    if (dict != null && dict.ContainsKey(m.UserId)) uName = dict[m.UserId];

                    <tr>
                        <td>@m.UserId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                            font-size:.8rem">
                                    @uName.Substring(0, 1)
                                </div>
                                <span class="fw-bold">@uName</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E3F2FD;
                                         color:#1565C0">
                                <i class="bi bi-building me-1"></i>
                                @m.CompanyName
                            </span>
                        </td>
                        <td>@(m.CommercialRegister ?? "—")</td>
                        <td>
                            @if (m.Website != null)
                            {
                                <a href="@m.Website" target="_blank"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-globe me-1"></i>
                                    الموقع
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                   asp-route-id="@m.UserId"
                                   class="btn btn-sm btn-outline-warning"
                                   title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@m.UserId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}