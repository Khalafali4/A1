@model Da3m.Domain.ManufacturerDetail
@{
    ViewData["Title"] = "تعديل بيانات المصنّع";
}

<div class="page-header">
    <h2><i class="bi bi-building me-2"></i>تعديل بيانات المصنّع</h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label fw-bold">
                اسم الشركة
            </label>
            <input asp-for="CompanyName" class="form-control" />
            <span asp-validation-for="CompanyName"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CommercialRegister"
                   class="form-label fw-bold">
                السجل التجاري
            </label>
            <input asp-for="CommercialRegister"
                   class="form-control" />
        </div>

        <div class="mb-4">
            <label asp-for="Website" class="form-label fw-bold">
                الموقع الإلكتروني
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-globe"></i>
                </span>
                <input asp-for="Website" class="form-control" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>