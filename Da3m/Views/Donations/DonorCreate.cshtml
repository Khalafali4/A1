@{
    ViewData["Title"] = "إضافة تبرع";
}

<div class="page-header">
    <h2><i class="bi bi-cash-coin me-2"></i>إضافة تبرع جديد</h2>
    <p>شكراً لتبرعك — مساهمتك تصنع فرقاً</p>
</div>

<div class="da3m-table p-4" style="max-width:500px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- ✅ UserId تلقائي -->
        <input type="hidden" name="UserId"
               value="@ViewBag.DonorUserId" />

        <div class="mb-3">
            <label class="form-label fw-bold">المبلغ</label>
            <div class="input-group">
                <input name="Amount" class="form-control"
                       type="number" step="0.01"
                       min="0.01" placeholder="0.00"
                       required />
                <span class="input-group-text">$</span>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">
                ملاحظة (اختياري)
            </label>
            <textarea name="Note" class="form-control"
                      rows="3"
                      placeholder="أي ملاحظات..."></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> تبرع الآن
            </button>
            <a asp-action="Index"
                   class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>