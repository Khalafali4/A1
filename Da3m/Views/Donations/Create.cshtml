@model Da3m.Domain.Donation
@{
    ViewData["Title"] = "إضافة تبرع";
    bool isDonor = ViewBag.DonorId != null;
}

<div class="page-header">
    <h2>
        <i class="bi bi-cash-coin me-2"
           style="color:#2E7D32"></i>
        إضافة تبرع جديد
    </h2>
    <p>شكراً لمساهمتك في دعم المرضى</p>
</div>

<div class="da3m-table p-4" style="max-width:500px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @if (isDonor)
        {
            <input type="hidden" name="UserId"
                   value="@ViewBag.DonorId" />
            <div class="alert alert-info py-2 mb-4">
                <i class="bi bi-person-check me-2"></i>
                <strong>المتبرع:</strong>
                @ViewBag.DonorName
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label fw-bold">
                    المتبرع
                </label>
                <select asp-for="UserId"
                        class="form-select">
                    <option value="">
                        -- اختر المتبرع --
                    </option>
                    @if (ViewData["Users"] != null)
                    {
                        foreach (var u in (IEnumerable<Da3m.Domain.User>)ViewData["Users"])
                        {
                            <option value="@u.UserId">
                                @u.FullName
                            </option>
                        }
                    }
                </select>
            </div>
        }

        <div class="mb-3">
            <label class="form-label fw-bold">
                المبلغ
                <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Amount"
                       class="form-control"
                       type="number"
                       step="0.01" min="0.01"
                       placeholder="0.00"
                       required />
            </div>
            <span asp-validation-for="Amount"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">
                ملاحظة (اختياري)
            </label>
            <textarea asp-for="Note"
                      class="form-control" rows="3"
                      placeholder="أي ملاحظات...">
            </textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-success">
                <i class="bi bi-check-lg me-1"></i>
                تبرّع الآن
            </button>
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i>
                رجوع
            </a>
        </div>
    </form>
</div>