@model Da3m.Domain.Donation
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إضافة تبرع";
}

<div class="page-header">
    <h2><i class="bi bi-cash-coin me-2"></i>إضافة تبرع جديد</h2>
    <p>أدخل بيانات التبرع</p>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="UserId" class="form-label fw-bold">
                المتبرع
            </label>
            <select asp-for="UserId" class="form-select"
                    asp-items="@(new SelectList(
                                                            (IEnumerable<Da3m.Domain.User>)ViewData["Users"],
                                                            "UserId", "FullName"))">
                <option value="">-- اختر المتبرع --</option>
            </select>
            <span asp-validation-for="UserId"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label fw-bold">
                المبلغ
            </label>
            <div class="input-group">
                <input asp-for="Amount" class="form-control"
                       type="number" step="0.01"
                       min="0.01" placeholder="0.00" />
                <span class="input-group-text">$</span>
            </div>
            <span asp-validation-for="Amount"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Note" class="form-label fw-bold">
                ملاحظة (اختياري)
            </label>
            <textarea asp-for="Note" class="form-control"
                      rows="3"
                      placeholder="أي ملاحظات إضافية..."></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> حفظ
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>