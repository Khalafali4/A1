@model Da3m.Domain.Donation
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "تعديل التبرع";
}

<div class="page-header">
    <h2><i class="bi bi-cash-coin me-2"></i>تعديل التبرع</h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DonationId" />
        <input type="hidden" asp-for="DonationDate" />

        <div class="mb-3">
            <label asp-for="UserId" class="form-label fw-bold">
                المتبرع
            </label>
            <select asp-for="UserId" class="form-select"
                    asp-items="@(new SelectList(
                     (IEnumerable<Da3m.Domain.User>)ViewData["Users"], "UserId", "FullName",
                                                            Model.UserId))">
                <option value="">-- اختر المتبرع --</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label fw-bold">
                المبلغ
            </label>
            <div class="input-group">
                <input asp-for="Amount" class="form-control"
                       type="number" step="0.01" min="0.01" />
                <span class="input-group-text">$</span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Note" class="form-label fw-bold">
                ملاحظة
            </label>
            <textarea asp-for="Note" class="form-control"
                      rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>