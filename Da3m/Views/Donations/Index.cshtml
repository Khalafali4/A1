@model IEnumerable<Da3m.Domain.Donation>
@{
    ViewData["Title"] = "التبرعات";
    var usersDict = ViewData["UsersDict"]
                    as Dictionary<int, string>
                    ?? new Dictionary<int, string>();

    decimal totalAmount = (decimal)(ViewBag.TotalAmount ?? 0m);
    int count = (int)(ViewBag.DonationsCount ?? 0);

    bool isAdmin = ViewBag.CurrentRole?.ToString()
                       .ToLower() == "admin"
                || ViewBag.CurrentRole?.ToString() == "مدير";
}

<div class="page-header d-flex justify-content-between
             align-items-center">
    <div>
        <h2>
            <i class="bi bi-cash-coin me-2"
               style="color:#2E7D32"></i>
            التبرعات
        </h2>
        <p>سجل التبرعات المالية في المنصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة تبرع
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success
                 alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<!-- إحصائيات -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="da3m-table p-4"
             style="background:linear-gradient(
                        135deg,#E8F5E9,#F1F8E9)">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon"
                     style="background:#2E7D32">
                    <i class="bi bi-cash-coin"
                       style="color:white"></i>
                </div>
                <div>
                    <div class="stat-num"
                         style="color:#2E7D32">
                        $@totalAmount.ToString("N2")
                    </div>
                    <div class="stat-label">
                        إجمالي التبرعات
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="da3m-table p-4"
             style="background:linear-gradient(
                        135deg,#E3F2FD,#BBDEFB)">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon"
                     style="background:#1565C0">
                    <i class="bi bi-receipt"
                       style="color:white"></i>
                </div>
                <div>
                    <div class="stat-num"
                         style="color:#1565C0">
                        @count
                    </div>
                    <div class="stat-label">
                        عدد التبرعات
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد تبرعات مسجلة حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المتبرع</th>
                    <th>المبلغ</th>
                    <th>التاريخ</th>
                    <th>ملاحظة</th>
                    @if (isAdmin)
                    {
                        <th>الإجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Donation d in Model)
                {
                    var uName = usersDict
                        .ContainsKey(d.UserId)
                        ? usersDict[d.UserId] : "—";

                    <tr>
                        <td style="font-size:.82rem;
                                   color:#7a8999">
                            #@d.DonationId
                        </td>
                        <td>
                            <div class="d-flex
                                align-items-center
                                gap-2">
                                <div class="user-avatar"
                                     style="width:32px;
                                    height:32px;
                                    font-size:.8rem;
                                    background:linear-gradient(
                                    135deg,
                                    #E65100,
                                    #AD1457)">
                                    @uName.Substring(0, 1)
                                </div>
                                <span class="fw-bold"
                                      style="font-size:.88rem">
                                    @uName
                                </span>
                            </div>
                        </td>
                        <td>
                            <span class="fw-bold"
                                  style="color:#2E7D32;
                                font-size:1rem">
                                $@d.Amount.ToString("N2")
                            </span>
                        </td>
                        <td style="font-size:.85rem">
                            @d.DonationDate.ToString("yyyy/MM/dd")
                        </td>
                        <td style="font-size:.82rem;
                            color:#7a8999;
                            max-width:150px;
                            overflow:hidden;
                            text-overflow:ellipsis;
                            white-space:nowrap">
                            @(d.Note ?? "—")
                        </td>
                        @if (isAdmin)
                        {
                            <td>
                                <form asp-action="Delete"
                                      asp-route-id="@d.DonationId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'حذف هذا التبرع؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm
                                        btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background:#E8F5E9;
                    font-weight:700">
                    <td colspan="2">الإجمالي</td>
                    <td style="color:#2E7D32">
                        $@totalAmount.ToString("N2")
                    </td>
                    <td colspan="@(isAdmin ? 3 : 2)"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}