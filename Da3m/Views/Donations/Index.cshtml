@model IEnumerable<Da3m.Domain.Donation>
@{
    ViewData["Title"] = "التبرعات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-cash-coin me-2"></i>التبرعات</h2>
        <p>سجل جميع التبرعات المالية في المنصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة تبرع
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد تبرعات مسجلة حالياً
    </div>
}
else
{
    <!-- ── إحصائيات ── -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon mb-2"
                     style="background:#FCE4EC">
                    <i class="bi bi-cash-stack"
                       style="color:#AD1457"></i>
                </div>
                <div class="stat-num">
                    $@Model.Sum(d => d.Amount).ToString("N2")
                </div>
                <div class="stat-label">إجمالي كل التبرعات</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon mb-2"
                     style="background:#E8F5E9">
                    <i class="bi bi-receipt"
                       style="color:#2E7D32"></i>
                </div>
                <div class="stat-num">@Model.Count()</div>
                <div class="stat-label">عدد عمليات التبرع</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon mb-2"
                     style="background:#E3F2FD">
                    <i class="bi bi-graph-up"
                       style="color:#1565C0"></i>
                </div>
                <div class="stat-num">
                    $@Model.Average(d => d.Amount).ToString("N2")
                </div>
                <div class="stat-label">متوسط التبرع</div>
            </div>
        </div>
    </div>

    <!-- ── الجدول ── -->
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المتبرع</th>
                    <th>مبلغ العملية</th>
                    <th>إجمالي تبرعاته</th>
                    <th>التاريخ</th>
                    <th>الملاحظة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Donation donation in Model)
                {
                    
                        var dict = ViewData["UsersDict"]
                                   as Dictionary<int, string>;
                        var totals = ViewData["Totals"]
                                     as Dictionary<int, decimal>;

                        var uName = "—";
                        if (dict != null &&
                            dict.ContainsKey(donation.UserId))
                            uName = dict[donation.UserId];

                        var total = 0m;
                        if (totals != null &&
                            totals.ContainsKey(donation.UserId))
                            total = totals[donation.UserId];
                    
                    <tr>
                        <td>@donation.DonationId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                    font-size:.8rem">
                                    @uName.Substring(0, 1)
                                </div>
                                <span class="fw-bold">@uName</span>
                            </div>
                        </td>
                        <td>
                            <span class="fw-bold"
                                  style="color:#2E7D32;font-size:1rem">
                                $@donation.Amount.ToString("N2")
                            </span>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E8F5E9;
                                color:#2E7D32">
                                <i class="bi bi-graph-up me-1"></i>
                                $@total.ToString("N2")
                            </span>
                        </td>
                        <td>
                            @donation.DonationDate.ToString("yyyy/MM/dd")
                        </td>
                        <td>@(donation.Note ?? "—")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                       asp-route-id="@donation.DonationId"
                                       class="btn btn-sm btn-outline-warning"
                                       title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@donation.DonationId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <!-- ── Footer الإجمالي ── -->
            <tfoot>
                <tr style="background:#F0F4F8;font-weight:700">
                    <td colspan="2" class="text-end">
                        الإجمالي الكلي:
                    </td>
                    <td style="color:#2E7D32">
                        $@Model.Sum(d => d.Amount).ToString("N2")
                    </td>
                    <td colspan="4"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}