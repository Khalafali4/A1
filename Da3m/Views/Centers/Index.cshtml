@model IEnumerable<Da3m.Domain.Center>
@{
    ViewData["Title"] = "المراكز";
    var role = ViewBag.CurrentRole as string ?? "";
    bool isAdmin = role.ToLower() == "admin" || role == "مدير";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-hospital-fill me-2"></i>المراكز</h2>
        <p>إدارة مراكز الدعم والتأهيل</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> إضافة مركز
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد مراكز مسجلة حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم المركز</th>
                    <th>الموقع</th>
                    <th>الهاتف</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Center center in Model)
                {
                    <tr>
                        <td>@center.CenterId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:36px;height:36px;
                                    background:#E3F2FD;
                                    border-radius:8px;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    color:#1565C0">
                                    <i class="bi bi-hospital"></i>
                                </div>
                                <span class="fw-bold">
                                    @center.CenterName
                                </span>
                            </div>
                        </td>
                        <td>@center.LocationText</td>
                        <td>@center.Phone</td>
                        <td>
                            @if (center.IsActive)
                            {
                                <span class="badge-status"
                                      style="background:#E8F5E9;
                                    color:#2E7D32">
                                    <i class="bi bi-check-circle me-1"></i>
                                    نشط
                                </span>
                            }
                            else
                            {
                                <span class="badge-status"
                                      style="background:#FFEBEE;
                                    color:#C62828">
                                    <i class="bi bi-x-circle me-1"></i>
                                    غير نشط
                                </span>
                            }
                        </td>
                        <td>
                            @if (isAdmin)
                            {
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit"
                                           asp-route-id="@center.CenterId"
                                           class="btn btn-sm btn-outline-warning"
                                           title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete"
                                          asp-route-id="@center.CenterId"
                                          method="post"
                                          style="display:inline"
                                          onsubmit="return confirm(
                                        'هل أنت متأكد من الحذف؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">صلاحية محددة (●'◡'●)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}