@model Da3m.Domain.Center
@{
    ViewData["Title"] = "إضافة مركز";
}

<div class="page-header">
    <h2><i class="bi bi-hospital me-2"></i>إضافة مركز جديد</h2>
    <p>أدخل بيانات مركز الدعم والتأهيل</p>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="CenterName" class="form-label fw-bold">
                اسم المركز
            </label>
            <input asp-for="CenterName" class="form-control"
                   placeholder="أدخل اسم المركز" />
            <span asp-validation-for="CenterName"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LocationText" class="form-label fw-bold">
                الموقع
            </label>
            <input asp-for="LocationText" class="form-control"
                   placeholder="المدينة، الحي، الشارع" />
            <span asp-validation-for="LocationText"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-bold">
                رقم الهاتف
            </label>
            <input asp-for="Phone" class="form-control"
                   placeholder="05xxxxxxxx" />
            <span asp-validation-for="Phone"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <div class="form-check form-switch">
                <input asp-for="IsActive"
                       class="form-check-input"
                       type="checkbox"
                       checked />
                <label asp-for="IsActive" class="form-check-label fw-bold">
                    المركز نشط
                </label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> حفظ
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>