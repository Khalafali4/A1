@model IEnumerable<Da3m.Domain.User>
@{
    ViewData["Title"] = "المستخدمون الموقوفون";
    var roles = ViewData["RolesDict"]
                as Dictionary<int, string>;
}

<div class="page-header d-flex justify-content-between
    align-items-center">
    <div>
        <h2>
            <i class="bi bi-archive me-2"></i>
            المستخدمون الموقوفون
        </h2>
        <p>يمكنك استرجاعهم في أي وقت</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-right me-1"></i>
        المستخدمون النشطون
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد مستخدمون موقوفون
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>البريد</th>
                    <th>الدور</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.User user in Model)
                {
                    var roleName = roles != null &&
                        roles.ContainsKey(user.RoleId)
                        ? roles[user.RoleId] : "—";

                    <tr style="opacity:.7">
                        <td>@user.UserId</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge-status"
                                  style="background:#FFEBEE;
                                color:#C62828">
                                @roleName
                            </span>
                        </td>
                        <td>
                            <form asp-action="Restore"
                                  asp-route-id="@user.UserId"
                                  method="post"
                                  style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-success">
                                    <i class="bi bi-person-check me-1"></i>
                                    استرجاع
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}