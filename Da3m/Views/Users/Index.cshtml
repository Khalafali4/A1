@model IEnumerable<Da3m.Domain.User>
@{
    ViewData["Title"] = "المستخدمون";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-people-fill me-2"></i>المستخدمون</h2>
        <p>إدارة جميع مستخدمي المنصة</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة مستخدم
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا يوجد مستخدمون مسجلون حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الهاتف</th>
                    <th>الدور</th>
                    <th>تاريخ التسجيل</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.User user in Model)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                            font-size:.8rem">
                                    @user.FullName.Substring(0, 1)
                                </div>
                                <span class="fw-bold">@user.FullName</span>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>
                            @{
                                var roles = (Dictionary<int, string>)ViewBag.Roles;
                                var roleName = roles.ContainsKey(user.RoleId) ? roles[user.RoleId] : "...";
                            }
                            <span class="badge-status"
                                  style="background:#E3F2FD;
                                         color:#1565C0">
                                  <i class="bi bi-shield me-1"></i>@roleName
                                @user.RoleId
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Details"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-info"
                                   title="تفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-warning"
                                   title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@user.UserId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                          'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}