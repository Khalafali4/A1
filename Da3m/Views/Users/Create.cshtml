@model Da3m.Domain.User
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "إضافة مستخدم";
}

<div class="page-header">
    <h2><i class="bi bi-person-plus-fill me-2"></i>إضافة مستخدم جديد</h2>
    <p>أدخل البيانات ثم اختر الدور لإكمال التسجيل</p>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-bold">
                الاسم الكامل
            </label>
            <input asp-for="FullName" class="form-control"
                   placeholder="أدخل الاسم الكامل" />
            <span asp-validation-for="FullName"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">
                البريد الإلكتروني
            </label>
            <input asp-for="Email" class="form-control"
                   placeholder="example@mail.com" />
            <span asp-validation-for="Email"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-bold">
                رقم الهاتف
            </label>
            <input asp-for="Phone" class="form-control"
                   placeholder="09xxxxxxxx" />
            <span asp-validation-for="Phone"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-bold">
                كلمة المرور
            </label>
            <input asp-for="Password" type="password"
                   class="form-control" />
            <span asp-validation-for="Password"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="RoleId" class="form-label fw-bold">
                الدور
            </label>
            <select asp-for="RoleId" class="form-select"
                    asp-items="@(new SelectList(
                                                (IEnumerable<Da3m.Domain.Role>)ViewBag.Roles, "RoleId", "RoleName"))">
                <option value="">-- اختر الدور --</option>
            </select>
            <span asp-validation-for="RoleId"
                  class="text-danger small"></span>

            <!-- تلميح للمستخدم -->
            <div class="mt-2 p-2 rounded"
                 style="background:#E3F2FD; font-size:.82rem; color:#1565C0">
                <i class="bi bi-info-circle me-1"></i>
                بعد الحفظ ستنتقل تلقائياً لإكمال بيانات الدور المختار
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i> حفظ والمتابعة
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> رجوع
            </a>
        </div>
    </form>
</div>