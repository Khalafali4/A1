@model Da3m.Domain.User
@{
    ViewData["Title"] = "تفاصيل المستخدم";
    var role = ViewBag.RoleName as string ?? "—";
    bool isPatient = role.ToLower() == "patient"
                       || role == "مريض";
    bool isDoctor = role.ToLower() == "doctor"
                       || role == "طبيب";
    bool isDonor = role.ToLower() == "donor"
                       || role == "متبرع";
    bool isManufacturer = role.ToLower() == "manufacturer"
                       || role == "مصنع";
}

<div class="page-header d-flex justify-content-between
    align-items-center">
    <div>
        <h2>
            <i class="bi bi-person-badge me-2"></i>
            تفاصيل المستخدم
        </h2>
        <p>عرض كامل لبيانات المستخدم</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index"
               class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> رجوع
        </a>
        <a asp-action="Edit"
               asp-route-id="@Model.UserId"
               class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i> تعديل
        </a>
    </div>
</div>

<div class="row g-3">

    <!-- البطاقة الشخصية -->
    <div class="col-md-4">
        <div class="da3m-table p-4 text-center">
            <div class="user-avatar mx-auto mb-3"
                 style="width:80px;height:80px;
                font-size:2rem;
                background:linear-gradient(
                135deg,#1565C0,#00ACC1)">
                @Model.FullName.Substring(0, 1)
            </div>

            <h5 class="fw-bold mb-1">@Model.FullName</h5>

            @{
                var roleBg = isDoctor ? "#E8F5E9"
                           : isPatient ? "#FCE4EC"
                           : isDonor ? "#FFF3E0"
                           : isManufacturer ? "#F3E5F5"
                           : "#E3F2FD";
                var roleColor = isDoctor ? "#2E7D32"
                              : isPatient ? "#AD1457"
                              : isDonor ? "#E65100"
                              : isManufacturer ? "#6A1B9A"
                              : "#1565C0";
                var roleIcon = isDoctor ? "bi-person-badge"
                             : isPatient ? "bi-person-heart"
                             : isDonor ? "bi-gift"
                             : isManufacturer ? "bi-building"
                             : "bi-shield";
            }

            <span class="badge-status d-inline-block mb-3"
                  style="background:@roleBg;color:@roleColor">
                <i class="bi @roleIcon me-1"></i>
                @role
            </span>

            <hr />

            <div class="text-start">
                <div class="mb-3">
                    <div class="text-muted"
                         style="font-size:.78rem">
                        <i class="bi bi-envelope me-1"></i>
                        البريد الإلكتروني
                    </div>
                    <div class="fw-bold"
                         style="font-size:.88rem">
                        @Model.Email
                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-muted"
                         style="font-size:.78rem">
                        <i class="bi bi-phone me-1"></i>
                        الهاتف
                    </div>
                    <div class="fw-bold"
                         style="font-size:.88rem">
                        @(Model.Phone ?? "—")
                    </div>
                </div>
                <div>
                    <div class="text-muted"
                         style="font-size:.78rem">
                        <i class="bi bi-calendar me-1"></i>
                        تاريخ التسجيل
                    </div>
                    <div class="fw-bold"
                         style="font-size:.88rem">
                        @Model.CreatedAt.ToString("yyyy/MM/dd")
                    </div>
                </div>
            </div>
            <hr />

            <!-- إجراءات سريعة -->
            <div class="d-grid gap-2">
                @if (isPatient)
                {
                    <a asp-controller="PatientDetails"
                       asp-action="Details"
                       asp-route-id="@Model.UserId"
                       class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-clipboard-pulse me-1"></i>
                        الملف الطبي
                    </a>
                }
                @if (isDoctor)
                {
                    <a asp-controller="Doctors"
                       asp-action="Details"
                       asp-route-id="@Model.UserId"
                       class="btn btn-sm btn-outline-success">
                        <i class="bi bi-person-badge me-1"></i>
                        بيانات الطبيب
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- تفاصيل حسب الدور -->
    <div class="col-md-8">

        @if (isDoctor)
        {
            var doc = ViewBag.DoctorDetail
                as Da3m.Domain.Doctor;
            <div class="da3m-table p-4">
                <h6 class="fw-bold mb-3"
                    style="color:#2E7D32">
                    <i class="bi bi-person-badge me-1"></i>
                    بيانات الطبيب
                </h6>
                @if (doc != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#E8F5E9">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    التخصص
                                </div>
                                <div class="fw-bold">
                                    @(doc.Specialty ?? "—")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#F8F9FA">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    رقم الترخيص
                                </div>
                                <div class="fw-bold">
                                    @(doc.LicenseNumber ?? "—")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#F8F9FA">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    المستشفى
                                </div>
                                <div class="fw-bold">
                                    @(doc.HospitalName ?? "—")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#E3F2FD">
                                <div class="text-muted"
                                     style="font-size:.78rem;
                                            color:#1565C0">
                                    المركز
                                </div>
                                <div class="fw-bold"
                                     style="color:#1565C0">
                                    @(ViewBag.CenterName ?? "—")
                                    </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 mb-0">
                        لم تُكمل بياناته الطبية
                    </div>
                }
            </div>
        }

        @if (isPatient)
        {
            var pat = ViewBag.PatientDetail
                as Da3m.Domain.PatientDetail;
            int measCount = ViewBag.MeasurementsCount ?? 0;
            int matchCount = ViewBag.MatchesCount ?? 0;

            <div class="da3m-table p-4 mb-3">
                <h6 class="fw-bold mb-3"
                    style="color:#AD1457">
                    <i class="bi bi-person-heart me-1"></i>
                    البيانات الطبية
                </h6>
                @if (pat != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#F8F9FA">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    الرقم الوطني
                                </div>
                                <div class="fw-bold">
                                    @pat.NationalId
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#F8F9FA">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    الجنس
                                </div>
                                <div class="fw-bold">
                                    @(pat.Gender ?? "—")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#F8F9FA">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    تاريخ الميلاد
                                </div>
                                <div class="fw-bold">
                                    @pat.BirthDate.ToString("yyyy/MM/dd")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#FCE4EC">
                                <div class="text-muted"
                                     style="font-size:.78rem;
                                            color:#AD1457">
                                    نوع الإعاقة
                                </div>
                                <div class="fw-bold"
                                     style="color:#AD1457">
                                    @(pat.DisabilityType ?? "—")
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- إحصائيات المريض -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="stat-card text-center">
                        <div class="stat-icon mx-auto mb-2"
                             style="background:#E3F2FD">
                             <i class="bi bi-rulers"
                               style="color:#1565C0"></i>
                        </div>
                        <div class="stat-num">@measCount</div>
                        <div class="stat-label">القياسات</div>
                        <a asp-controller="Measurements"
                           asp-action="Index"
                           class="btn btn-sm
                                  btn-outline-primary mt-2">
                            عرض القياسات
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="stat-card text-center">
                        <div class="stat-icon mx-auto mb-2"
                             style="background:#E0F7FA">
                            <i class="bi bi-shuffle"
                               style="color:#00838F"></i>
                        </div>
                        <div class="stat-num">@matchCount</div>
                        <div class="stat-label">المطابقات</div>
                        <a asp-controller="Matches"
                           asp-action="Index"
                           class="btn btn-sm
                                  btn-outline-info mt-2">
                            عرض المطابقات
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (isDonor)
        {
            var don = ViewBag.DonorDetail
                as Da3m.Domain.DonorDetail;
            int donCount = ViewBag.DonationsCount ?? 0;
            decimal total = ViewBag.TotalDonations ?? 0m;

            <div class="da3m-table p-4">
                <h6 class="fw-bold mb-3"
                    style="color:#E65100">
                    <i class="bi bi-gift me-1"></i>
                    بيانات المتبرع
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded text-center"
                             style="background:#FCE4EC">
                            <div class="fw-bold"
                                 style="color:#AD1457;
                                        font-size:1.5rem">
                                $@total.ToString("N0")
                            </div>
                            <div class="text-muted"
                                 style="font-size:.8rem">
                                إجمالي التبرعات
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded text-center"
                             style="background:#E8F5E9">
                            <div class="fw-bold"
                                 style="color:#2E7D32;
                                        font-size:1.5rem">
                                @donCount
                            </div>
                            <div class="text-muted"
                                 style="font-size:.8rem">
                                عدد التبرعات
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (isManufacturer)
        {
            var mfr = ViewBag.ManufacturerDetail
                as Da3m.Domain.ManufacturerDetail;
            int devCount = ViewBag.DevicesCount ?? 0;

            <div class="da3m-table p-4">
                <h6 class="fw-bold mb-3"
                    style="color:#6A1B9A">
                    <i class="bi bi-building me-1"></i>
                    بيانات المصنّع
                </h6>
                @if (mfr != null)
                {
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="p-3 rounded"
                                 style="background:#F3E5F5">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    اسم الشركة
                                </div>
                                <div class="fw-bold"
                                     style="color:#6A1B9A">
                                    @mfr.CompanyName
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded"
                                 style="background:#F8F9FA">
                                <div class="text-muted"
                                     style="font-size:.78rem">
                                    رقم السجل التجاري
                                </div>
                                <div class="fw-bold">
    @(string.IsNullOrWhiteSpace(mfr.CommercialRegister) ? "—" : mfr.CommercialRegister)
</div>  
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded text-center"
                                 style="background:#E8F5E9">
                                <div class="fw-bold"
                                     style="color:#2E7D32;
                                    font-size:1.5rem">
                                    @devCount
                                </div>
                                <div class="text-muted"
                                     style="font-size:.8rem">
                                    إجمالي الأجهزة
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>