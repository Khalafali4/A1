@model Da3m.Domain.Measurement
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "تعديل القياس";
}

<div class="page-header">
    <h2><i class="bi bi-rulers me-2"></i>تعديل القياس</h2>
</div>

<div class="da3m-table p-4" style="max-width:600px">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MeasurementId" />
        <input type="hidden" asp-for="MeasuredAt" />
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="LimbType"
                   class="form-label fw-bold">
                نوع الطرف
            </label>
            <select asp-for="LimbType" class="form-select">
                <option value="">-- اختر --</option>
                <option value="طرف علوي أيمن">
                    طرف علوي أيمن 🦾
                </option>
                <option value="طرف علوي أيسر">
                    طرف علوي أيسر 🦾
                </option>
                <option value="طرف سفلي أيمن">
                    طرف سفلي أيمن 🦿
                </option>
                <option value="طرف سفلي أيسر">
                    طرف سفلي أيسر 🦿
                </option>
            </select>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label asp-for="LengthCm"
                       class="form-label fw-bold">
                    الطول (cm)
                </label>
                <div class="input-group">
                    <input asp-for="LengthCm"
                           class="form-control"
                           type="number" step="0.01" />
                    <span class="input-group-text">cm</span>
                </div>
            </div>
            <div class="col mb-3">
                <label asp-for="WidthCm"
                       class="form-label fw-bold">
                    العرض (cm)
                </label>
                <div class="input-group">
                    <input asp-for="WidthCm"
                           class="form-control"
                           type="number" step="0.01" />
                    <span class="input-group-text">cm</span>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Notes"
                   class="form-label fw-bold">
                ملاحظات
            </label>
            <textarea asp-for="Notes"
                          class="form-control" rows="3">
            </textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-check-lg me-1"></i>
                    حفظ التعديلات
                </button>
                <a asp-action="Index"
                       class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </form>
    </div>