@model IEnumerable<Da3m.Domain.Measurement>
@{
    ViewData["Title"] = "القياسات";
    var dict = ViewData["UsersDict"] as Dictionary<int, string>;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-rulers me-2"></i>القياسات</h2>
        <p>قياسات الأطراف للمرضى المسجلين</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إضافة قياس
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        لا توجد قياسات مسجلة حالياً
    </div>
}
else
{
    <div class="da3m-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المريض</th>
                    <th>نوع الطرف</th>
                    <th>الطول (cm)</th>
                    <th>العرض (cm)</th>
                    <th>الملاحظات</th>
                    <th>تاريخ القياس</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Da3m.Domain.Measurement m in Model)
                {
                    var uName = "—";
                    if (dict != null && dict.ContainsKey(m.UserId))
                        uName = dict[m.UserId];

                    <tr>
                        <td>@m.MeasurementId</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar"
                                     style="width:32px;height:32px;
                                            font-size:.8rem ">
                                    @uName.Substring(0, 1)
                                </div>
                                <span class="fw-bold">@uName</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#F3E5F5;
                                color:#6A1B9A ; white-space:nowrap">
                                @m.LimbType
                            </span>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E3F2FD;
                                color:#1565C0 ; white-space:nowrap">
                                @m.LengthCm cm
                            </span>
                        </td>
                        <td>
                            <span class="badge-status"
                                  style="background:#E8F5E9;
                                color:#2E7D32 ; white-space:nowrap">
                                @m.WidthCm cm
                            </span>
                        </td>
                        <td>@(m.Notes ?? "—")</td>
                        <td>@m.MeasuredAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit"
                                   asp-route-id="@m.MeasurementId"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete"
                                      asp-route-id="@m.MeasurementId"
                                      method="post"
                                      style="display:inline"
                                      onsubmit="return confirm(
                                    'هل أنت متأكد من الحذف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}